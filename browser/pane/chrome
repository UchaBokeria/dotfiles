#!/usr/bin/env python3
"""Real Chrome in the current pane: complete Xvfb window or one page."""
import argparse
import json
import os
from pathlib import Path
import shlex
import signal
import socket
import subprocess
import sys
import time

ROOT=Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT))
from lifetime import Lease,parent_death,stop,tm
import mode as browser_mode
import termios
RUNTIME=Path.home()/'.local/share/browser-pane/casty/bin/casty.js'
parser=argparse.ArgumentParser(description='Real graphical Chrome in this pane. Default: same full Xvfb Chrome as Remmina. Ctrl+Q returns to shell. Ctrl+A then Esc toggles browser/tmux controls.')
mode=parser.add_mutually_exclusive_group();mode.add_argument('--page',action='store_true',help='Single-page view: Alt+L address, Alt+F hints')
mode.add_argument('--full',action='store_true',help='Full shared Chrome window (default): Ctrl+L address, Ctrl+T tab, extensions and all browser UI')
parser.add_argument('--ssh',metavar='HOST',help='Reach Blackwall through SSH (automatic on Arch; configurable with CHROME_SSH_HOST)')
parser.add_argument('url',nargs='?')
a=parser.parse_args()
if not sys.stdin.isatty() or not sys.stdout.isatty():sys.exit('chrome needs an interactive Kitty-compatible terminal. Run it directly in a tmux pane.')
config_path=Path.home()/'.config/browser-pane/config.json'
config=json.loads(config_path.read_text()) if config_path.exists() else {}
local=(Path.home()/'.config/.claude-chrome-vncpw.txt').exists()
remote=a.ssh or os.environ.get('CHROME_SSH_HOST') or (config.get('ssh_host','blackwall') if not local else '')
helper=config.get('remote_helper','/home/scriptkid/opt/cloud/browser/pane/connection.py')
ssh=['ssh','-o','ConnectTimeout=10']
if config.get('ssh_identity'):ssh+=['-i',str(Path(config['ssh_identity']).expanduser())]
tunnel=None;child=None;lease=None;registered=False;pane=os.environ.get('TMUX_PANE') if os.environ.get('TMUX') else None
saved_terminal=termios.tcgetattr(0)
def closed(signum,_frame):raise SystemExit(128+signum)
for sig in (signal.SIGHUP,signal.SIGTERM):signal.signal(sig,closed)
try:
    if remote:
        command=['python3',helper]+([a.url] if a.url and not a.page else [])
        info=json.loads(subprocess.check_output([*ssh,remote,shlex.join(command)],text=True))
        with socket.socket() as s:s.bind(('127.0.0.1',0));port=s.getsockname()[1]
        destination=9222 if a.page else 5900
        tunnel=subprocess.Popen([*ssh,'-N','-o','ExitOnForwardFailure=yes','-L',f'127.0.0.1:{port}:127.0.0.1:{destination}',remote],stdin=subprocess.DEVNULL,stderr=subprocess.PIPE,preexec_fn=parent_death)
        deadline=time.monotonic()+12
        while True:
            if tunnel.poll() is not None:sys.exit('SSH tunnel failed: '+tunnel.stderr.read().decode().strip())
            try:
                with socket.create_connection(('127.0.0.1',port),timeout=.2):break
            except OSError:
                if time.monotonic()>deadline:sys.exit('SSH tunnel did not become ready')
                time.sleep(.05)
        info.update(host='127.0.0.1',port=port)
    else:
        from connection import prepare
        info=prepare(a.url if not a.page else None)
        port=9222
    if pane:
        lease=Lease(pane);browser_mode.register(pane);registered=True
    env={**os.environ,'CASTY_CDP_PORT':str(port),'CASTY_TRANSPORT':'inline','CHROME_PLACEHOLDER_DATA':str(ROOT/'placeholder-diacritics.json')}
    if a.page:
        if not RUNTIME.exists():sys.exit('Install page mode with browser/pane/install.sh first.')
        command=['node',str(RUNTIME),a.url or 'https://www.google.com']
    else:
        env['CHROME_VNC_INFO']=json.dumps(info)
        # Clipboard bridge (desktop.py/clipboard.py): sink = Blackwall :99 over ssh when remote; source host for a Blackwall viewer.
        if remote:env['CHROME_CLIP_SINK']=json.dumps({'host':remote,'identity':config.get('ssh_identity'),'dir':str(Path(helper).parent)})
        env['CHROME_CLIP_SOURCE']=config.get('clipboard_source','archlinux')
        python=Path.home()/'.local/share/browser-pane/venv/bin/python'
        command=[str(python) if python.exists() else sys.executable,str(ROOT/'desktop.py')]
    signal.signal(signal.SIGINT,lambda *_:None)
    child=subprocess.Popen(command,env=env,preexec_fn=parent_death)
    while True:
        try:
            code=child.wait(timeout=.25);break
        except subprocess.TimeoutExpired:
            if lease:
                if not lease.alive():stop(child);code=0;break
                current=tm('display-message','-p','-t',pane,'#{window_id}')
                if current!=lease.window:
                    lease.release();lease=Lease(pane)
                browser_mode.sync()
    sys.exit(code)
except (OSError,subprocess.CalledProcessError,ValueError) as error:
    sys.exit(f'chrome: {error}')
finally:
    stop(child)
    if registered:
        try:browser_mode.unregister(pane)
        except (RuntimeError,OSError):pass
    if lease:
        try:lease.release()
        except (RuntimeError,OSError):pass
    try:
        sys.stdout.buffer.write(b'\x1b[0m\x1b[?1003l\x1b[?1006l\x1b[?2004l\x1b[?25h\x1b[?1049l');sys.stdout.buffer.flush()
    except OSError:pass
    try:termios.tcsetattr(0,termios.TCSADRAIN,saved_terminal)
    except termios.error:pass
    stop(tunnel)
