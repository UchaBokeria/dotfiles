# 177M installed by `npm ci` in this directory. The step `opencode-deps` in
# installer/data/steps.toml re-creates it; package.json and package-lock.json
# are tracked so the MCP servers and plugins pin to the versions used here.
node_modules

# bun writes its own lock beside npm's; one lockfile is enough to reproduce.
bun.lock

# opencode rewrites its own config and leaves the previous one behind.
opencode.json.bak-*

# Session state and memory, not configuration.
memory.json
