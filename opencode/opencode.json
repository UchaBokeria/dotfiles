{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/fish",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "plugin": [
    "@morphllm/opencode-morph-plugin",
    "opencode-background-agents",
    "opencode-websearch-cited",
    "@tarquinen/opencode-dcp@latest",
    [
      "@zenobius/opencode-skillful",
      {
        "basePaths": [
          "{env:HOME}/.config/opencode/skills",
          "{env:HOME}/.claude/skills",
          "{env:HOME}/.claude/plugins/cache",
          ".opencode/skills"
        ],
        "promptRenderer": "markdown"
      }
    ],
    "@prevalentware/opencode-goal-plugin",
    "opencode-openai-codex-auth"
  ],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *mitmproxy/certs*": "deny",
      "rm *.key*": "deny",
      "*UNIPROXY_DEBUG_RAW*": "deny"
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "dockerfile": {
      "command": [
        "docker-langserver",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    }
  },
  "experimental": {
    "mcp_timeout": 1200000
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--autoConnect",
        "--experimentalVision",
        "--experimentalScreencast",
        "--categoryExtensions",
        "--memoryDebugging"
      ],
      "enabled": true,
      "timeout": 1200000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "environment": {
        "MEMORY_FILE": "{env:HOME}/.config/opencode/memory.json"
      },
      "enabled": true,
      "timeout": 1200000
    },
    "chrome-direct": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9223",
        "--experimentalVision",
        "--experimentalScreencast",
        "--categoryExtensions",
        "--memoryDebugging"
      ],
      "enabled": true,
      "timeout": 1200000
    },
    "chrome-blackwall": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9224"
      ],
      "enabled": true,
      "timeout": 1200000
    },
    "cdp": {
      "type": "local",
      "command": [
        "{env:HOME}/.bun/bin/bun",
        "{env:HOME}/.config/opencode/bin/cdp-mcp.ts"
      ],
      "environment": {
        "CDP_HUB": "ws://127.0.0.1:9225/hub",
        "CDP_BROWSER": "archlinux-1"
      },
      "enabled": true,
      "timeout": 1200000
    },
    "playwright": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/@playwright/mcp/cli.js"
      ],
      "enabled": true,
      "timeout": 1200000
    }
  },
  "providers": {
    "meta": {
      "name": "Meta Model API",
      "env": [
        "MODEL_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible/responses",
      "settings": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "modelID": "muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576
          }
        }
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT 5.2 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.2-codex": {
          "name": "GPT 5.2 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex-max": {
          "name": "GPT 5.1 Codex Max (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex": {
          "name": "GPT 5.1 Codex (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1-codex-mini": {
          "name": "GPT 5.1 Codex Mini (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.1": {
          "name": "GPT 5.1 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "low"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "high"
            }
          }
        }
      }
    }
  }
}