{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/fish",
  "disabled_providers": [
    "nvidia"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-background-agents",
    "opencode-websearch-cited",
    [
      "@zenobius/opencode-skillful",
      {
        "basePaths": [
          "{env:HOME}/.config/opencode/skills",
          "{env:HOME}/.claude/skills",
          "{env:HOME}/.claude/plugins/cache",
          ".opencode/skills"
        ],
        "promptRenderer": "markdown"
      }
    ],
    "@prevalentware/opencode-goal-plugin",
    "opencode-openai-codex-auth",
    [
      "@knikolov/opencode-plugin-simple-memory",
      {
        "autoLoad": true,
        "autoSave": true,
        "contextLimit": 5,
        "contextMaxChars": 1200
      }
    ],
    "opencode-mem"
  ],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *mitmproxy/certs*": "deny",
      "rm *.key*": "deny",
      "*UNIPROXY_DEBUG_RAW*": "deny"
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "dockerfile": {
      "command": [
        "docker-langserver",
        "--stdio"
      ],
      "extensions": [
        ".dockerfile"
      ]
    },
    "csharp": {
      "disabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 1200000
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--autoConnect",
        "--experimentalVision",
        "--experimentalScreencast",
        "--categoryExtensions",
        "--memoryDebugging"
      ],
      "enabled": false,
      "timeout": 1200000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "environment": {
        "MEMORY_FILE": "{env:HOME}/.config/opencode/memory.json"
      },
      "enabled": true,
      "timeout": 1200000
    },
    "chrome-direct": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9223",
        "--experimentalVision",
        "--experimentalScreencast",
        "--categoryExtensions",
        "--memoryDebugging"
      ],
      "enabled": true,
      "timeout": 1200000
    },
    "chrome-blackwall": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9224"
      ],
      "enabled": true,
      "timeout": 1200000
    },
    "cdp": {
      "type": "local",
      "command": [
        "{env:HOME}/.bun/bin/bun",
        "{env:HOME}/.config/opencode/bin/cdp-mcp.ts"
      ],
      "environment": {
        "CDP_HUB": "ws://127.0.0.1:9225/hub",
        "CDP_BROWSER": "archlinux-1"
      },
      "enabled": true,
      "timeout": 1200000
    },
    "playwright": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "{env:HOME}/.config/opencode/node_modules/@playwright/mcp/cli.js"
      ],
      "enabled": true,
      "timeout": 1200000
    },
    "memories": {
      "type": "local",
      "command": [
        "{env:HOME}/.bun/bin/memories",
        "serve"
      ],
      "enabled": true,
      "timeout": 1200000
    }
  },
  "provider": {
    "modal-glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM-5.3-Flash-CYBERSECURITY (Modal, local shim)",
      "env": [
        "MODAL_GLM_API_KEY"
      ],
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "{env:MODAL_GLM_API_KEY}"
      },
      "models": {
        "dealignai/GLM-5.3-Flash-CYBERSECURITY-W4A16": {
          "name": "GLM-5.3-Flash Cybersec (modal-glm)",
          "tools": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "meta-uchaprimary": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Meta Model API - uchaprimary",
      "env": [
        "MODEL_API_KEY_UCHAPRIMARY"
      ],
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY_UCHAPRIMARY}"
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Muse Spark 1.3 (uchaprimary)",
          "tools": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "minimal": {
              "reasoningEffort": "minimal"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "pdf",
              "audio"
            ],
            "output": [
              "text"
            ]
          }
        },
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (uchaprimary)",
          "tools": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "minimal": {
              "reasoningEffort": "minimal"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "pdf",
              "audio"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "env": [
        "NVIDIA_API_KEY"
      ],
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "whitelist": [
        "z-ai/glm-5.3",
        "meta/llama-3.2-11b-vision-instruct",
        "nvidia/nemotron-3-ultra-550b-a55b",
        "nvidia/nemotron-3-super-120b-a12b",
        "moonshotai/kimi-k3",
        "poolside/laguna-xs-2.1",
        "openai/gpt-oss-20b",
        "meta/llama-3.2-90b-vision-instruct"
      ],
      "models": {
        "z-ai/glm-5.3": {
          "name": "GLM 5.3 (nvidia-nim)",
          "tools": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "meta/llama-3.2-11b-vision-instruct": {
          "name": "Llama 3.2 11B Vision (nvidia-nim)",
          "tools": false,
          "limit": {
            "context": 131072,
            "output": 4096
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B (nvidia-nim)",
          "tools": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Nemotron 3 Super 120B (nvidia-nim)",
          "tools": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 (nvidia-nim)",
          "tools": true,
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "poolside/laguna-xs-2.1": {
          "name": "Laguna XS 2.1 coding (nvidia-nim)",
          "tools": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B (nvidia-nim)",
          "tools": true,
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "meta/llama-3.2-90b-vision-instruct": {
          "name": "Llama 3.2 90B Vision (nvidia-nim)",
          "tools": false,
          "limit": {
            "context": 131072,
            "output": 4096
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
