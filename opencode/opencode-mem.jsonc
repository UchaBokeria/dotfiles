{
  // opencode-mem: local Turso/libSQL vector memory. Full template with all
  // keys is auto-created here on first startup; these are our chosen values.
  "storagePath": "~/.opencode-mem/data",
  "userEmailOverride": "ucha1bokeria@gmail.com",
  "userNameOverride": "UchaBokeria",
  // Local embeddings (downloaded from HF on first use, cached under storagePath/.cache)
  "embeddingModel": "Xenova/nomic-embed-text-v1",

  "memory": {
    "defaultScope": "project"
  },
  "webServerEnabled": true,
  "webServerPort": 4747,
  "webServerHost": "127.0.0.1",

  // Background auto-capture uses our own provider list: meta-lucky is a
  // provider ID from opencode.json, model is its model ID.
  "autoCaptureEnabled": true,
  "autoCaptureLanguage": "auto",
  "opencodeProvider": "meta-lucky",
  "opencodeModel": "muse-spark-1.3-contributor",

  "showAutoCaptureToasts": true,
  "showUserProfileToasts": true,
  "showErrorToasts": true,

  "userProfileAnalysisInterval": 10,
  "userProfileMaxContextBytes": 32768,
  "maxMemories": 10,

  "compaction": {
    "enabled": true,
    "memoryLimit": 10
  },
  "chatMessage": {
    "enabled": true,
    "maxMemories": 3,
    "excludeCurrentSession": true,
    "injectOn": "first"
  }
}
