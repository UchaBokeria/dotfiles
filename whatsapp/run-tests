#!/usr/bin/env bash
# wa test suite - mirrors theme/run-tests
set -uo pipefail
cd "$(dirname "$0")"
fail=0
note() { printf '\n\033[1m== %s\033[0m\n' "$1"; }

note "gofmt"
unformatted=$(gofmt -l . 2>/dev/null)
if [ -n "$unformatted" ]; then
    echo "not gofmt'd:"; echo "$unformatted"; fail=1
else
    echo "all files formatted"
fi

note "go vet"
CGO_ENABLED=0 go vet ./... || fail=1

note "go test"
CGO_ENABLED=0 go test ./... || fail=1

note "build"
CGO_ENABLED=0 go build -o /dev/null ./cmd/wa || fail=1

# The repo's rule is that a documented command must actually be reachable.
# wa is a compiled binary rather than a script, so it reaches PATH through
# `make install` instead of scripts/link-bin - which means the cheatsheet has
# to say so, or the command is documented and uninstallable.
note "docs"
cheatsheet=../docs/cheatsheet.md
if ! grep -q '^## WhatsApp' "$cheatsheet"; then
    echo "docs/cheatsheet.md has no WhatsApp section"; fail=1
elif ! grep -q 'make install' "$cheatsheet"; then
    echo "docs/cheatsheet.md documents wa without saying how to install it"; fail=1
else
    echo "cheatsheet documents wa and how to install it"
fi
if ! grep -q '^install:' Makefile; then
    echo "the Makefile has no install target"; fail=1
fi
# The shipped config must be the same one embedded in the binary, or the
# documented defaults and the real ones drift apart.
if ! diff -q config.toml internal/config/default.toml >/dev/null; then
    echo "config.toml has drifted from internal/config/default.toml"; fail=1
else
    echo "shipped config matches the embedded defaults"
fi

if [ "$fail" -ne 0 ]; then
    printf '\n\033[31mFAILED\033[0m\n'; exit 1
fi
printf '\n\033[32mall checks passed\033[0m\n'
