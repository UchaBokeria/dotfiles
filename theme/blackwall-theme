#!/usr/bin/env python3
"""Entry point. Pure stdlib, so it runs on the system interpreter with no venv
- setwall must work on a fresh boot before any project environment exists."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from blackwall_theme.__main__ import main  # noqa: E402

raise SystemExit(main())
