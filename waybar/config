{
  "layer": "bottom",
  "position": "top",
  "height": 52,
  "spacing": 0,
  // top right bottom left. A gap above the bar lets the wallpaper
  // run behind it, which is what makes the capsules read as floating
  // rather than as fixed to the screen edge.
  "margin": "7 0 0 0",
  "fixed-center": true,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["group/media"],
  "modules-right": ["group/right"],

  "include": [
    "~/.config/waybar/modules/workspaces.json",
    "~/.config/waybar/modules/mpris.json",
    "~/.config/waybar/modules/keyboard.json",
    "~/.config/waybar/modules/network.json",
    "~/.config/waybar/modules/pulseaudio.json",
    "~/.config/waybar/modules/clock.json",
    "~/.config/waybar/modules/swaync.json",
    "~/.config/waybar/modules/archpilot.json",
    "~/.config/waybar/modules/custom.jsonc"
  ]
}

