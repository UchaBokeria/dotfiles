{
	"custom/archpilot": {
		"format": "{}",
		"return-type": "json",
		"exec": "$HOME/.config/.dotfiles/blackwall/archpilot/.venv/bin/archpilot waybar --watch",
		"restart-interval": 5,
		"on-click": "$HOME/.config/.dotfiles/blackwall/archpilot/.venv/bin/archpilot ui --toggle",
		"on-click-right": "$HOME/.config/.dotfiles/blackwall/archpilot/.venv/bin/archpilot ui",
		"on-click-middle": "$HOME/.config/.dotfiles/blackwall/archpilot/.venv/bin/archpilot set mode --cycle",
		"tooltip": true
	}
}
