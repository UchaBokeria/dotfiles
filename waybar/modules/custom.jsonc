{
	"custom/mpris-prev": {
		"format": "󰒮",
		"tooltip": false,
		"on-click": "playerctl previous"
	},

	"custom/mpris-playpause": {
		"format": "󰐎",
		"tooltip": false,
		"on-click": "playerctl play-pause"
	},

	"custom/mpris-next": {
		"format": "󰒭",
		"tooltip": false,
		"on-click": "playerctl next"
	},

	"group/right": {
		"orientation": "inherit",
		"modules": [
			"keyboard-state",
			"clock#date",
			"clock#time",
			"pulseaudio",
			"network",
			"custom/control-center"
		]
	},

	"custom/control-center": {
		"format": "󰣇",
		"tooltip": false,
		"on-click": "~/.config/eww/scripts/toggle control_center"
	},
}

