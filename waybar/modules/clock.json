{
    "group/clock": {
        "orientation": "horizontal",
        "modules": [
            "clock#date",
            "clock#time"
        ]
    },
    "clock#date": {
        "interval": 60,
        "format": "{:%a - %d}",
        "tooltip": false,
        "on-click": "~/.config/eww/scripts/toggle calendar"
    },
    "clock#time": {
        "interval": 10,
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "~/.config/eww/scripts/toggle calendar"
    }
}
