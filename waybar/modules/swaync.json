{
  "custom/swaync": {
    "format": "{icon}{text}",
    "format-icons": {
      "notification": "\udb80\udc9a",
      "none": "\udb80\udc9c",
      "dnd-notification": "\udb80\udc9b",
      "dnd-none": "\udb80\udc9b"
    },
    "return-type": "json",
    "interval": 2,
    "exec": "~/.config/.dotfiles/blackwall/scripts/blackwall-bar notifications",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "~/.config/.dotfiles/blackwall/scripts/blackwall-quiet dnd toggle",
    "escape": true
  }
}
