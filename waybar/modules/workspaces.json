// The workspace pills.
//
// These were one `hyprland/workspaces` module until 2026-09-13. That module
// renders fine, but it sends a click into Hyprland's socket as
// `dispatch workspace 3`, and under the Lua config Hyprland parses a dispatch
// as a Lua expression - so every click was a silent syntax error and the bar
// did nothing. waybar cannot override that dispatch per button, so each
// workspace is its own custom module now, with an on-click we control.
//
// They are refreshed by signal 9, sent by `blackwall-bar-workspaces listen`
// (started by blackwall-autostart) whenever a workspace changes. Empty text
// hides a module, which is how workspaces that do not exist stay hidden.
{
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/ws5",
      "custom/ws6",
      "custom/ws7",
      "custom/ws8",
      "custom/ws9",
      "custom/ws10"
    ]
  },
  "custom/ws1": {
    "exec": "~/.config/.dotfiles/blackwall/scripts/blackwall-bar-workspaces render 1",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.config/.dotfiles/blackwall/scripts/blackwall-bar-workspaces focus 1",
    "tooltip": true
  },
  "custom/ws2": {
    "exec": "~/.config/.dotfiles/blackwall/scripts/blackwall-bar-workspaces render 2",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.config/.dotfiles/blackwall/scripts/blackwall-bar-workspaces focus 2",
    "tooltip": true
  },
  "custom/ws3": {
    "exec": "~/.config/.dotfiles/blackwall/scripts/blackwall-bar-workspaces render 3",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
