{
	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "󰝟",

		"tooltip": true,
		"tooltip-format": "Volume: {volume}%\nScroll: change volume",

		"on-click": "~/.config/eww/scripts/toggle audio",
		"on-click-right": "pavucontrol",
		"scroll-step": 5,

		"format-icons": {
			"headphones": "󰋋",
			"handsfree": "󰋎",
			"phone": "󰏲",
			"portable": "󰏳",
			"car": "󰄋",
			"default": ["󰕿", "󰖀", "󰕾"]
		}
	},
	"pulseaudio/slider": {
		"orientation": "horizontal",
		"min": 0,
		"max": 100,
	},
	"group/audio": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 300,
			"children-class": "audio-mods"
		},
		"modules": [
			"pulseaudio",
			"pulseaudio/slider"
		]
	}
}
