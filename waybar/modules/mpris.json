{
  "group/mpris": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "mpris-hidden",
      "transition-left-to-right": true
    },
    "modules": [
      "mpris",
      "custom/mpris-prev",
      "custom/mpris-playpause",
      "custom/mpris-next"
    ]
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{player_icon} <i>{dynamic}</i>",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "dynamic-separator": " — ",
    "dynamic-len": 50,
    "artist-len": 26,
    "title-len": 34,
    "on-click": "~/.config/eww/scripts/toggle player",

    "tooltip": true,
    "tooltip-format": "{player}\n⏮ middle-click   ⏯ click   ⏭ right-click",
    "tooltip-format-paused": "{player}\n⏮ middle-click   ⏯ click   ⏭ right-click",

    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "chromium": "",
      "mpv": "",
      "vlc": "󰕼"
    },

    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    }
  }
}

