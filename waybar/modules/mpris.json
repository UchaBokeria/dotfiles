{
  "group/media": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "mpris-hidden",
      "transition-left-to-right": true
    },
    "modules": [
      "mpris",
      "custom/mpris-prev",
      "custom/mpris-playpause",
      "custom/mpris-next"
    ]
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{player_icon} <i>{dynamic}</i>",
    "format-stopped": "",
    "dynamic-order": [
      "artist",
      "title"
    ],
    "dynamic-separator": " \u2014 ",
    "dynamic-len": 50,
    "artist-len": 26,
    "title-len": 34,
    "on-click": "~/.config/.dotfiles/blackwall/scripts/blackwall-media-focus",
    "tooltip": true,
    "tooltip-format": "{player}\nclick to jump to it",
    "tooltip-format-paused": "{player}\nclick to jump to it",
    "player-icons": {
      "default": "\uf001",
      "spotify": "\uf1bc",
      "firefox": "\uf269",
      "chromium": "\uf268",
      "mpv": "\uf36e",
      "vlc": "\udb81\udd7c"
    },
    "status-icons": {
      "playing": "\uf04b",
      "paused": "\uf04c",
      "stopped": ""
    }
  }
}
