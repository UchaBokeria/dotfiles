#!/usr/bin/env bash
# blackwall-autostart - everything the session needs, started once.
#
#   blackwall-autostart          start whatever is not running
#   blackwall-autostart --status what is up and what is not
#
# Called from the Hyprland config (hypr/lua/env.lua) on every config pass, so
# it has to be safe to run again: each service starts only if it is not
# already running. A top-level `hl.exec_cmd` runs on EVERY reload, and an
# autostart that was not idempotent once left about two hundred waybars
# behind. `hl.on("hyprland.start", ...)` avoids that but has its own failure -
# if the event has already fired, nothing starts at all, and the session comes
# up with no bar. Idempotent and unconditional is the combination that cannot
# fail either way.
#
# It also waits for the compositor to answer before starting Wayland clients.
# At login Hyprland runs the config before the outputs exist, and a bar
# started in that window dies immediately - the "no waybar until I run
# hyprctl reload" symptom.
set -uo pipefail

BW="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RUN="${XDG_RUNTIME_DIR:-/tmp}/blackwall"
mkdir -p "$RUN"

# Two passes overlapping (a reload while the first is still waiting for the
# compositor) would double-start everything the first pass has not reached yet.
exec 9>"$RUN/autostart.lock"
# Login forensics (2026-09-26): waybar + wallpaper missing until reload.
# Every pass appends one line so the next login shows exactly what ran when.
LOG="$RUN/autostart.log"
log() { printf '%s pid=%s %s\n' "$(date '+%F %T')" "$$" "$*" >>"$LOG" 2>/dev/null; }
log "pass start argv=[$*]"
if ! flock -n 9; then log "pass skipped: lock held"; exit 0; fi
# Every child below closes fd 9 (`9>&-`). Without that the daemons inherit the
# open lock file and hold it for as long as they run, so the NEXT pass fails
# the flock and exits silently - which would quietly disable this whole script
# a second after it first worked.

status_only=0
[[ "${1:-}" == "--status" ]] && status_only=1

say() { printf 'autostart: %s\n' "$*" >&2; log "$*"; }

# A binary we can recognise by name. pgrep -x only, never -f: a -f pattern
# matches this script's own command line too.
binary_up() { pgrep -x "$1" >/dev/null 2>&1; }

# Our own scripts run under a shebang, so their process name is the
# interpreter and pgrep cannot see them. They get a pidfile - and, when that is
# missing (started by hand, or by the config before this script existed), a
# scan of /proc that adopts whatever is already running. Without the adoption
# step a missing pidfile means a second copy of a daemon every time, which is
# how seventeen blackwall-watch processes accumulated.
#
# The scan reads /proc directly rather than using `pgrep -f`, whose pattern
# would also match this script's own command line.
script_up() {
    local pidfile="$RUN/$1.pid" pid cmdline
    if [[ -r "$pidfile" ]]; then
        pid="$(<"$pidfile")"
        # /proc/PID/cmdline separates arguments with NULs, so a MATCH that spans
        # two arguments ("blackwall-quiet dnd-watch") can only match once they
        # are turned into spaces, the way scan_for reads them. Compared in the
        # shell rather than through `| grep -q`: under pipefail a grep that quits
        # at its first match can leave the writer with SIGPIPE, and the pipeline
        # then reports failure for a process that is plainly the daemon.
        if [[ "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]]; then
            cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
            [[ "$cmdline" == *"$2"* ]] && return 0
        fi
    fi
    pid="$(scan_for "$2")" || return 1
    echo "$pid" > "$pidfile"
    return 0
}

scan_for() {                          # scan_for MATCH -> pid on stdout
    local pid cmdline
    for pid in /proc/[0-9]*; do
        pid="${pid#/proc/}"
        [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
        cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" || continue
        if [[ "$cmdline" == *"$1"* ]]; then
            echo "$pid"
            return 0
        fi
    done
    return 1
}

start_binary() {                      # start_binary NAME CMD...
    local name="$1"; shift
    binary_up "$name" && { ((status_only)) && say "$name up"; return 0; }
    ((status_only)) && { say "$name DOWN"; return 0; }
    # Login forensics 2026-09-26: waybar was absent until reload with no trace
    # of why. Capture early stderr so a service that dies on launch says why;
    # verify it is actually alive afterwards instead of assuming the spawn
    # worked. The log from a healthy start is one line; from a failure, gold.
    local early="$RUN/$name-early.log"
    setsid "$@" >"$early" 2>&1 9>&- &
    sleep 2
    if binary_up "$name"; then
        say "started $name"
    else
        say "FAILED to start $name (early log follows)"
        say "--- $name early log ---"
        head -c 2000 "$early" 2>/dev/null | while IFS= read -r line; do say "$line"; done
        say "--- end $name early log ---"
    fi
}

start_script() {                      # start_script TAG MATCH CMD...
    local tag="$1" match="$2"; shift 2
    script_up "$tag" "$match" && { ((status_only)) && say "$tag up"; return 0; }
    ((status_only)) && { say "$tag DOWN"; return 0; }
    setsid "$@" >/dev/null 2>&1 9>&- &
    echo $! > "$RUN/$tag.pid"
    say "started $tag"
}

# ---- wait for the compositor --------------------------------------------
# Not just "hyprctl answers" but "an output exists with dimensions". At login
# the compositor answers before outputs are ready; a bar started in that
# window finds no layer surface and exits, and nothing retries it until the
# next reload - the "no waybar until hyprctl reload" symptom.
if ! ((status_only)); then
    for _ in $(seq 1 80); do
        hyprctl monitors -j 2>/dev/null | grep -q '"width": [1-9]' && break
        sleep 0.25
    done
fi

# ---- the authentication agent --------------------------------------------
# Without one running, every pkexec prompt fails silently - which is exactly
# how scripts/blackwall-ask and scripts/blackwall-setkey fail: the panel
# button does nothing and nothing is logged. Whichever agent is installed
# will do; they all implement the same interface.
for agent in \
    /usr/lib/polkit-kde-authentication-agent-1 \
    /usr/lib/hyprpolkitagent \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
do
    [[ -x $agent ]] || continue
    # The liveness test is pgrep -x, which matches /proc/<pid>/comm - and the
    # kernel truncates that to 15 characters. Passing the full name meant the
    # check never matched and a second agent was started on every run, which
    # is the same shape as the bug that once left two hundred waybars.
    name=$(basename "$agent"); name=${name:0:15}
    start_binary "$name" "$agent"
    break
done

# ---- notifications -------------------------------------------------------
# Exactly one of these may own org.freedesktop.Notifications. The test is on
# the binary, so installing the package is the only step needed to switch.
if command -v swaync >/dev/null; then
    if ! binary_up swaync; then
        ((status_only)) && say "swaync DOWN" || {
            systemctl --user stop mako.service >/dev/null 2>&1
            setsid swaync >/dev/null 2>&1 9>&- &
            say "started swaync"
        }
    else
        ((status_only)) && say "swaync up"
    fi
elif ! ((status_only)); then
    systemctl --user start mako.service >/dev/null 2>&1
fi

# ---- the desktop ---------------------------------------------------------
start_binary waybar waybar
start_binary eww eww daemon
# awww-daemon SIGABRTs when a second instance starts on its socket ("There is
# an awww-daemon instance already running on this socket!", reproduced live
# 2026-09-26). last_wallpaper races this line with its own pgrep-or-start, so
# a plain pgrep gate is not enough: health-check via `awww query` (answers
# only when the daemon is actually serving) and serialize the start itself.
awww_alive() { awww query >/dev/null 2>&1; }
if ! awww_alive; then
    (
        flock -n 200 || exit 0
        awww_alive && exit 0
        setsid awww-daemon >/dev/null 2>&1 9>&- &
        say "started awww-daemon"
    ) 200>"$RUN/awww.lock"
else
    ((status_only)) && say "awww-daemon up"
fi

# The wallpaper is restored after the daemon is up; the script retries on its
# own if the daemon is still starting.
if ! ((status_only)); then
    if ! awww query 2>/dev/null | grep -q 'currently displaying: image:'; then
        setsid "$HOME/.config/hypr/scripts/last_wallpaper" >/dev/null 2>&1 9>&- &
        say "restoring wallpaper"
    fi
fi

# ---- optional extras -----------------------------------------------------
# Neither is installed on this machine right now; the config used to start
# them unconditionally, which just logged two failures at every login.
command -v wayvnc >/dev/null && start_binary wayvnc wayvnc -R -v -L debug 127.0.0.1 5900
command -v xfsettingsd >/dev/null && start_binary xfsettingsd xfsettingsd

# ---- our own daemons -----------------------------------------------------
start_script notifyd blackwall-notifyd "$BW/scripts/blackwall-notifyd"
# The MATCH names the mode, not just the script: `blackwall-watch --list`, a
# mute from a clicked card, or `blackwall-quiet dnd on` are short-lived runs of
# the same script and must not be mistaken for the daemon.
start_script watch "blackwall-watch --daemon" "$BW/scripts/blackwall-watch" --daemon
# DND is a setting; this keeps it true in practice. swaync lets Critical
# urgency through even with DND on (notiDaemon.vala:224), and blackwall-watch
# raises those - so the setting alone does not silence the screen. The daemon
# writes the visibility rule that does, and follows the setting however it was
# flipped, including from swaync's own switch.
start_script quiet-dnd "blackwall-quiet dnd-watch" "$BW/scripts/blackwall-quiet" dnd-watch

# blackwall-clip --daemon starts two `wl-paste --watch` processes and exits,
# so there is no pid of its own to watch - and running it again kills the
# watchers it finds before starting new ones, which would lose a clipboard
# entry on every reload. The watchers themselves are the liveness test.
# `pgrep -xc` prints 0 AND exits 1 when it finds nothing, so `|| echo 0` used to
# append a second zero: the test saw "0\n0", died with an arithmetic error, and
# the watchers were never started - while the status line still said "up".
# Counting lines gives one number whatever happens.
if [[ "$(pgrep -x wl-paste 2>/dev/null | wc -l)" -lt 2 ]]; then
    ((status_only)) && say "clip watchers DOWN" || {
        "$BW/scripts/blackwall-clip" --daemon >/dev/null 2>&1 9>&-
        say "started clip watchers"
    }
else
    ((status_only)) && say "clip watchers up"
fi
start_script barws blackwall-bar-workspaces "$BW/scripts/blackwall-bar-workspaces" listen

# ---- the glass plugin, after a system update --------------------------------
# hyprglass.so is built against the exact libraries Hyprland was built with.
# When pacman rebuilds Hyprland against a new aquamarine, the version string
# stays the same (0.56.2-1 -> 0.56.2-3 on 2026-09-18) but the soname moves
# (libaquamarine.so.13 -> .so.14), and at the next login Hyprland refuses the
# plugin. glass.lua cannot say so - a plugin that fails to load is simply not
# there - so the glass just went away, silently, until somebody noticed.
#
# If the installed plugin links a library that no longer exists, rebuild it in
# the background and say what is happening. The build takes about a minute;
# the desktop is usable on the compositor's own blur meanwhile.
GLASS_SO="$HOME/.local/share/blackwall/hyprglass/hyprglass.so"
if [[ -f $GLASS_SO ]] && ldd "$GLASS_SO" 2>/dev/null | grep -q 'not found'; then
    if ((status_only)); then
        say "glass plugin STALE (links a library this system no longer has)"
    else
        # A lock, not `pgrep -f`: a pattern match on command lines also matches
        # any shell that merely mentions it, and one rebuild at a time is the
        # only thing that needs guaranteeing.
        (
            flock -n 8 || exit 0
            say "glass plugin stale after a system update - rebuilding"
            notify-send -a "liquid glass" "Rebuilding the glass" \
                "Hyprland's libraries were updated; the plugin is being rebuilt to match. About a minute." 2>/dev/null
            if "$BW/scripts/blackwall-glass" install >/dev/null 2>&1; then
                notify-send -a "liquid glass" "Glass is back" "rebuilt for the new Hyprland libraries" 2>/dev/null
            else
                notify-send -u critical -a "liquid glass" "Glass rebuild failed" \
                    "run: blackwall-glass install" 2>/dev/null
            fi
        ) 8>"$RUN/glass-rebuild.lock" 9>&- &
        disown
    fi
elif ((status_only)) && [[ -f $GLASS_SO ]]; then
    say "glass plugin links cleanly"
fi

exit 0
