#!/usr/bin/env bash
# Network, bluetooth and VPN, as one interface.
#
#   blackwall-net status          one JSON blob describing everything
#   blackwall-net wifi-list       nearby networks, as JSON
#   blackwall-net wifi-toggle     radio on/off
#   blackwall-net wifi-connect SSID   connect, asking for a password if needed
#   blackwall-net wifi-forget SSID
#   blackwall-net bt-list         known and nearby devices, as JSON
#   blackwall-net bt-toggle
#   blackwall-net bt-connect MAC | bt-disconnect MAC | bt-forget MAC
#   blackwall-net vpn-toggle      tailscale up/down
#   blackwall-net pick-wifi       rofi picker (usable without the eww panel)
#   blackwall-net pick-bt
#
# Everything reads through nmcli, bluetoothctl and tailscale rather than
# touching config files, so the state here is the state those tools report and
# there is nothing of ours to fall out of sync.
set -uo pipefail

LAUNCH="$HOME/.config/rofi/blackwall/launch"
have() { command -v "$1" >/dev/null 2>&1; }
jstr() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().rstrip("\n")))'; }

# ---------------------------------------------------------------- status ---

wifi_state() {
    have nmcli || { echo '{"on":false,"ssid":"","signal":0}'; return; }
    local on ssid signal
    on="$(nmcli -t -f WIFI general status 2>/dev/null | grep -q enabled && echo true || echo false)"
    ssid="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
            | awk -F: '$2=="802-11-wireless"{print $1; exit}')"
    signal="$(nmcli -t -f IN-USE,SIGNAL device wifi 2>/dev/null \
              | awk -F: '$1=="*"{print $2; exit}')"
    printf '{"on":%s,"ssid":%s,"signal":%d}' \
        "$on" "$(printf '%s' "${ssid:-}" | jstr)" "${signal:-0}"
}

eth_state() {
    have nmcli || { echo '{"on":false,"name":""}'; return; }
    local name
    name="$(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null \
            | awk -F: '$1=="ethernet" && $2=="connected"{print $3; exit}')"
    printf '{"on":%s,"name":%s}' \
        "$([[ -n "$name" ]] && echo true || echo false)" \
        "$(printf '%s' "${name:-}" | jstr)"
}

vpn_state() {
    have tailscale || { echo '{"on":false,"name":"","ip":""}'; return; }
    timeout 5 tailscale status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print(json.dumps({"on": False, "name": "", "ip": ""})); raise SystemExit
me = d.get("Self") or {}
print(json.dumps({
    "on": d.get("BackendState") == "Running",
    "name": me.get("HostName", ""),
    "ip": (me.get("TailscaleIPs") or [""])[0],
    "peers": len(d.get("Peer") or {}),
}))' 2>/dev/null || echo '{"on":false,"name":"","ip":""}'
}

bt_state() {
    have bluetoothctl || { echo '{"on":false,"connected":""}'; return; }
    local powered connected
    powered="$(timeout 5 bluetoothctl show 2>/dev/null | grep -oP 'Powered: \K\w+')"
    connected="$(timeout 5 bluetoothctl devices Connected 2>/dev/null \
                 | head -1 | cut -d' ' -f3-)"
    printf '{"on":%s,"connected":%s}' \
        "$([[ "$powered" == yes ]] && echo true || echo false)" \
        "$(printf '%s' "${connected:-}" | jstr)"
}

# ------------------------------------------------------------------ lists ---

wifi_list() {
    have nmcli || { echo '[]'; return; }
    # Parsing moved to a python file next door: a BSSID is six colon-separated
    # octets inside a colon-separated record, and untangling that in shell is
    # how the MAC ended up mangled the first time.
    python3 "$(dirname "$(readlink -f "$0")")/blackwall-wifi.py" 2>/dev/null || echo '[]'
}

bt_list() {
    have bluetoothctl || { echo '[]'; return; }
    # `bluetoothctl info` per device, for its Icon - a freedesktop icon name
    # like audio-headset, which is the only thing that says what a device
    # actually is. Without it every row is the same bluetooth rune and a name.
    {
        timeout 5 bluetoothctl devices 2>/dev/null
        timeout 5 bluetoothctl devices Connected 2>/dev/null | sed 's/^/CONNECTED /'
        for m in $(timeout 5 bluetoothctl devices 2>/dev/null | awk '{print $2}'); do
            printf 'ICON %s %s\n' "$m" \
                "$(timeout 3 bluetoothctl info "$m" 2>/dev/null |
                   grep -oP 'Icon:\s*\K\S+' | head -1)"
        done
    } | python3 -c '
import json, sys

# Icon name -> glyph. Every codepoint here was rendered from the font and
# looked at first; guessing them produces symbols that are merely plausible.
GLYPHS = {
    "audio-headset":   "\U000f02cb",
    "audio-headphones":"\U000f02cb",
    "audio-card":      "\U000f04c3",
    "input-mouse":     "\U000f037d",
    "input-keyboard":  "\U000f030c",
    "input-gaming":    "\U000f0296",
    "phone":           "\U000f011c",
    "computer":        "\U000f0322",
    "printer":         "\U000f042a",
    "camera-photo":    "\U000f0100",
    "video-display":   "\U000f0379",
}
FALLBACK = "\U000f00af"          # the bluetooth rune

devices, connected, icons = {}, set(), {}
for line in sys.stdin:
    line = line.strip()
    if line.startswith("CONNECTED Device "):
        connected.add(line.split()[2])
    elif line.startswith("ICON "):
        parts = line.split(None, 2)
        if len(parts) >= 3:
            icons[parts[1]] = parts[2]
    elif line.startswith("Device "):
        parts = line.split(None, 2)
        if len(parts) >= 3:
            devices[parts[1]] = parts[2]
for mac in connected:
    devices.setdefault(mac, mac)
out = [{"mac": m, "name": n, "connected": m in connected,
        "icon": icons.get(m, ""),
        "glyph": GLYPHS.get(icons.get(m, ""), FALLBACK)}
       for m, n in devices.items()]
out.sort(key=lambda d: (not d["connected"], d["name"].lower()))
print(json.dumps(out))'
}

# ---------------------------------------------------------------- actions ---

# Every saved profile carrying this SSID, newest first.
#
# Matching on the profile NAME was wrong: NetworkManager names a profile after
# the SSID only until that name is taken, and then appends a number - this
# machine has both "OVIO_242059_5G" and "OVIO_242059_5G 1" for one network. A
# network whose only profile had been renamed that way looked unsaved, so the
# panel asked for a password it already held.
wifi_profiles() {
    local want="$1" name ssid
    nmcli -t -f NAME,TYPE connection show 2>/dev/null |
    awk -F: '$2 ~ /wireless/ {print $1}' |
    while IFS= read -r name; do
        ssid="$(nmcli -t -f 802-11-wireless.ssid connection show "$name" 2>/dev/null |
                cut -d: -f2-)"
        [[ "$ssid" == "$want" ]] && printf '%s\n' "$name"
    done
}

# Connecting to a device that has never been paired.
#
# `bluetoothctl connect` on an unknown device fails - it has no link key to
# use - so the panel could reach the headphones it already knew and nothing
# else. Pairing first, then trusting so it reconnects on its own afterwards,
# is what every other bluetooth UI does and what "scan for devices" implies is
# possible.
bt_connect() {
    local mac="$1"
    [[ -n "$mac" ]] || return 1
    local paired
    paired="$(timeout 5 bluetoothctl info "$mac" 2>/dev/null |
              grep -oP 'Paired:\s*\K\w+')"
    if [[ "$paired" != yes ]]; then
        notify-send -a blackwall "bluetooth" "pairing with $mac"
        if ! timeout 30 bluetoothctl pair "$mac" >/dev/null 2>&1; then
            notify-send -a blackwall -u critical "bluetooth" \
                "could not pair with $mac - put it in pairing mode and try again"
            return 1
        fi
        # Trusted, or it asks again on every reconnect.
        timeout 5 bluetoothctl trust "$mac" >/dev/null 2>&1
    fi
    if timeout 20 bluetoothctl connect "$mac" >/dev/null 2>&1; then
        notify-send -a blackwall "bluetooth" "connected"
    else
        notify-send -a blackwall -u critical "bluetooth" "could not connect to $mac"
    fi
}

wifi_connect() {
    local ssid="$1"
    [[ -n "$ssid" ]] || return 1

    # A saved network is never asked for its password. If bringing it up fails
    # it is reported as the failure it is - out of range, wrong band, the
    # device busy - because a prompt in that situation is a lie: it implies the
    # stored credential is the problem and invites you to retype one that was
    # already correct.
    local profile saved=""
    while IFS= read -r profile; do
        [[ -z "$profile" ]] && continue
        saved="$profile"
        if nmcli connection up id "$profile" >/dev/null 2>&1; then
            notify-send -a blackwall "wifi" "connected to $ssid"
            return 0
        fi
    done < <(wifi_profiles "$ssid")

    if [[ -n "$saved" ]]; then
        local err
        err="$(nmcli connection up id "$saved" 2>&1 | tail -1)"
        notify-send -a blackwall -u critical "wifi" \
            "could not join $ssid - ${err:-the network did not respond}"
        return 1
    fi

    # Genuinely new: an open network needs nothing, so try once before asking.
    if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
        notify-send -a blackwall "wifi" "connected to $ssid"
        return 0
    fi
    local pass
    pass="$(printf '' | "$LAUNCH" compact -dmenu -password -p "password for $ssid")" || return 0
    [[ -z "$pass" ]] && return 0
    if nmcli device wifi connect "$ssid" password "$pass" >/dev/null 2>&1; then
        notify-send -a blackwall "wifi" "connected to $ssid"
    else
        notify-send -a blackwall -u critical "wifi" "could not connect to $ssid"
    fi
}

# Right-click actions on a network. These are the things every desktop has and
# this panel did not: see the password you already saved, forget a network,
# hand the credentials to a phone.
wifi_menu() {
    local ssid="$1" saved=no items
    [[ -n "$ssid" ]] || return 1
    [[ -n "$(wifi_profiles "$ssid" | head -1)" ]] && saved=yes

    items="connect"
    [[ "$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null |
          awk -F: '$2=="802-11-wireless"{print $1}')" == "$ssid" ]] &&
        items="disconnect"
    if [[ "$saved" == yes ]]; then
        items="$items
show password
copy password
share by QR code
forget this network"
    fi
    items="$items
copy MAC address
network details"

    local choice
    choice="$(printf '%s' "$items" | "$LAUNCH" compact -dmenu -p "$ssid")" || return 0
    case "$choice" in
        connect)    wifi_connect "$ssid" ;;
        disconnect)
            nmcli connection down id "$(wifi_profiles "$ssid" | head -1)" >/dev/null 2>&1 &&
                notify-send -a blackwall "wifi" "disconnected from $ssid" ;;
        "show password")
            local psk; psk="$(wifi_psk "$ssid")"
            notify-send -a blackwall "$ssid" "${psk:-no password stored}" ;;
        "copy password")
            local psk; psk="$(wifi_psk "$ssid")"
            [[ -n "$psk" ]] && { printf '%s' "$psk" | wl-copy >/dev/null 2>&1
                notify-send -a blackwall "wifi" "password copied"; } ;;
        "share by QR code") wifi_qr "$ssid" ;;
        "forget this network")
            # Every profile for this SSID, or forgetting a network that has
            # been renamed once leaves the duplicate behind to reconnect.
            local gone=0 prof
            while IFS= read -r prof; do
                [[ -z "$prof" ]] && continue
                nmcli connection delete id "$prof" >/dev/null 2>&1 && gone=$((gone+1))
            done < <(wifi_profiles "$ssid")
            ((gone)) && notify-send -a blackwall "wifi" \
                "forgot $ssid${gone:+$([[ $gone -gt 1 ]] && echo " ($gone profiles)")}" ;;
        "copy MAC address")
            local bssid
            bssid="$(python3 "$(dirname "$(readlink -f "$0")")/blackwall-wifi.py" |
                     python3 -c '
import json,sys
want=sys.argv[1]
for n in json.load(sys.stdin):
    if n["ssid"]==want: print(n["bssid"]); break' "$ssid")"
            [[ -n "$bssid" ]] && { printf '%s' "$bssid" | wl-copy >/dev/null 2>&1
                notify-send -a blackwall "wifi" "$bssid copied"; } ;;
        "network details")
            notify-send -a blackwall "$ssid" "$(python3 "$(dirname "$(readlink -f "$0")")/blackwall-wifi.py" |
                python3 -c '
import json,sys
want=sys.argv[1]
for n in json.load(sys.stdin):
    if n["ssid"]==want:
        print(f"{n[\"sec\"]} · {n[\"sec_detail\"]}")
        print(f"{n[\"band\"]} channel {n[\"chan\"]} · {n[\"signal\"]}%")
        print(n["bssid"])
        break' "$ssid")" ;;
    esac
}

wifi_psk() {
    # Addressed by profile, not by SSID: the two differ whenever
    # NetworkManager has had to rename one. See wifi_profiles.
    local profile
    profile="$(wifi_profiles "$1" | head -1)"
    [[ -n "$profile" ]] || return 0
    nmcli -s -g 802-11-wireless-security.psk connection show "$profile" 2>/dev/null |
        grep -v "^Warning:" | head -1
}

# The QR encodes the standard WIFI: URI every phone camera understands, so
# sharing a network is pointing a camera at the screen rather than reading a
# password aloud.
wifi_qr() {
    local ssid="$1" psk sec tmp
    psk="$(wifi_psk "$ssid")"
    sec="WPA"; [[ -z "$psk" ]] && sec="nopass"
    tmp="$(mktemp --suffix=.png)"
    qrencode -s 8 -m 2 -o "$tmp" "WIFI:T:${sec};S:${ssid};P:${psk};;" 2>/dev/null || {
        notify-send -a blackwall "wifi" "qrencode is not installed"; return; }
    # imv/swayimg if present, otherwise hand it to xdg-open.
    for viewer in imv swayimg xdg-open; do
        command -v "$viewer" >/dev/null && { "$viewer" "$tmp" >/dev/null 2>&1 & return; }
    done
}

case "${1:-status}" in
    status)
        printf '{"wifi":%s,"eth":%s,"vpn":%s,"bt":%s}\n' \
            "$(wifi_state)" "$(eth_state)" "$(vpn_state)" "$(bt_state)"
        ;;
    wifi-list)  wifi_list ;;
    bt-list)    bt_list ;;
    wifi-toggle)
        nmcli -t -f WIFI general status 2>/dev/null | grep -q enabled \
            && nmcli radio wifi off || nmcli radio wifi on
        ;;
    wifi-menu)  wifi_menu "${2:-}" ;;
    wifi-disconnect)
        [[ -n "${2:-}" ]] && nmcli connection down id "$2" >/dev/null 2>&1
        ;;
    wifi-connect) wifi_connect "${2:-}" ;;
    wifi-forget)
        [[ -n "${2:-}" ]] && nmcli connection delete id "$2" >/dev/null 2>&1 \
            && notify-send "wifi" "forgot $2"
        ;;
    bt-toggle)
        [[ "$(bluetoothctl show 2>/dev/null | grep -oP 'Powered: \K\w+')" == yes ]] \
            && bluetoothctl power off >/dev/null || bluetoothctl power on >/dev/null
        ;;
    bt-connect)    bt_connect "${2:-}" & ;;
    bt-pair)       bt_connect "${2:-}" & ;;
    bt-disconnect) bluetoothctl disconnect "${2:-}" >/dev/null 2>&1 & ;;
    bt-forget)     bluetoothctl remove "${2:-}"     >/dev/null 2>&1 & ;;
    bt-scan)       (bluetoothctl --timeout 12 scan on >/dev/null 2>&1 &) ;;
    vpn-toggle)
        if timeout 5 tailscale status >/dev/null 2>&1; then
            tailscale down >/dev/null 2>&1 && notify-send "vpn" "tailscale down"
        else
            tailscale up >/dev/null 2>&1 && notify-send "vpn" "tailscale up"
        fi
        ;;
    pick-wifi)
        chosen="$(wifi_list | python3 -c '
import json, sys
for n in json.load(sys.stdin):
    mark = "*" if n["active"] else " "
    lock = "lock" if n["secure"] else "open"
    print(f"{mark} {n[\"ssid\"]}  ({n[\"signal\"]}%, {lock})")' \
            | "$LAUNCH" compact -dmenu -p "wifi")" || exit 0
        [[ -z "$chosen" ]] && exit 0
        ssid="$(printf '%s' "$chosen" | sed -E 's/^.\s+//; s/\s+\([0-9]+%.*\)$//')"
        wifi_connect "$ssid"
        ;;
    pick-bt)
        chosen="$(bt_list | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    print(("* " if d["connected"] else "  ") + d["name"] + "  [" + d["mac"] + "]")' \
            | "$LAUNCH" compact -dmenu -p "bluetooth")" || exit 0
        [[ -z "$chosen" ]] && exit 0
        mac="$(printf '%s' "$chosen" | grep -oP '\[\K[0-9A-F:]{17}')"
        if [[ "$chosen" == "* "* ]]; then
            bluetoothctl disconnect "$mac" >/dev/null 2>&1
        else
            bluetoothctl connect "$mac" >/dev/null 2>&1
        fi
        ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \?//' ;;
    *) echo "unknown: $1" >&2; exit 1 ;;
esac
