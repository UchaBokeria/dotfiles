#!/usr/bin/env python3
"""Every VPN on this machine, behind one interface.

    blackwall-vpn status              all backends, as JSON
    blackwall-vpn ts-toggle           tailscale up / down
    blackwall-vpn ts-switch ID        change tailnet profile
    blackwall-vpn ts-exit NODE|none   route through an exit node
    blackwall-vpn ts-dns on|off       use the tailnet's DNS
    blackwall-vpn ts-routes on|off    accept subnet routes
    blackwall-vpn forti-toggle        openfortivpn, from /etc/openfortivpn/config
    blackwall-vpn wg-toggle IFACE     wireguard

Tailscale supports several accounts at once and only one is live; the panel
used to show "tailscale, 3 peers" without saying *whose* tailnet, which is the
one thing you need when you hold four of them.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path


def run(cmd, timeout=8):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
        return 1, "", ""


def have(binary: str) -> bool:
    return shutil.which(binary) is not None


ASK = str(Path(__file__).resolve().parent / "blackwall-ask")


def notify(title: str, body: str, urgent: bool = False) -> None:
    argv = ["notify-send", "-a", "blackwall", title, body]
    if urgent:
        argv[1:1] = ["-u", "critical"]
    run(argv)


def eww(**vars_: str) -> None:
    """Push state straight into the panel."""
    if not vars_:
        return
    run(["eww", "update", *(f"{k}={v}" for k, v in vars_.items())], timeout=5)


def push_status() -> None:
    """Hand the panel a fresh reading rather than let it wait for its poll."""
    code, out, _ = run([str(Path(__file__).resolve()), "status"], timeout=10)
    if code == 0 and out.strip():
        eww(vpn_status=out.strip())


def confirm(what: str, want_up: bool, probe, busy: str = "",
            timeout: float = 12.0) -> None:
    """Wait for a toggle to actually take, say so if it does not, and keep the
    panel in step while it happens.

    Nothing here reported failure on its own. openfortivpn keeps running while
    it is connected, so the command cannot be waited on; wg-quick and pkill
    return long before the interface settles; and a wrong sudo password fails
    inside blackwall-ask, which the panel never hears about. The result was a
    click that looked identical whether it worked or not.

    The pushing is why the switch used to lag the notification by seconds.
    vpn_status is a defpoll on an 8s interval, so the panel found out when its
    timer next came round - up to eight seconds after this function already
    knew, and had said so in a notification. A status reading costs about 90ms,
    which is affordable at this cadence, so the panel is simply told.
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        time.sleep(0.7)
        if bool(probe()) == want_up:
            eww(net_busy="")
            push_status()
            notify(what, "connected" if want_up else "disconnected")
            return
        push_status()
    eww(net_busy="")
    push_status()
    notify(what,
           "could not connect - wrong password, or the server refused"
           if want_up else
           "could not disconnect - it is still up",
           urgent=True)


def as_root(reason: str, cmd: list[str]) -> None:
    """Run a privileged command, asking for the password in the rice's prompt.

    pkexec needs a polkit agent and this session runs none, so anything using
    it did nothing and said nothing. blackwall-ask uses the same rofi prompt
    that already asks for wi-fi passwords, so a password is typed in one
    recognisable place rather than in whichever terminal happened to open.
    """
    strip = [c for c in cmd if c != "sudo"]
    subprocess.Popen([ASK, "sudo", reason, "--", *strip],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def read_config(path: str) -> None:
    """Print a root-owned config as JSON so a widget can render its fields.

    openfortivpn and wireguard both use `key = value` files. Parsing them into
    fields means the panel can offer inputs instead of launching vim at
    somebody, which is what "configurable in the widget" has to mean.
    """
    code, out, _ = run(["sudo", "-n", "cat", path], timeout=5)
    if code != 0:
        try:
            out = Path(path).read_text()
        except OSError:
            print(json.dumps({"readable": False, "fields": [], "path": path}))
            return
    fields = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line.startswith("["):
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip(), v.strip()
        secret = "pass" in k.lower() or "key" in k.lower()
        fields.append({
            "key": k,
            # A secret's value never leaves this function - printing it into a
            # widget tree is a way to leak it. But blanking it also left the
            # panel unable to tell a set password from an absent one, so it
            # said "not set" over a configured account. `set` reports that
            # much without carrying the value.
            "value": "" if secret else v,
            "set": bool(v),
            "secret": secret,
        })
    print(json.dumps({"readable": True, "path": path, "fields": fields}))


def write_config(path: str, key: str, value: str) -> None:
    """Set one key in a root-owned `key = value` file, in place."""
    ask = str(Path(__file__).resolve().parent / "blackwall-ask")
    helper = str(Path(__file__).resolve().parent / "blackwall-setkey")
    subprocess.Popen([ask, "sudo", f"edit {Path(path).name}", "--",
                      helper, path, key, value],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def prompt_set(path: str, key: str) -> None:
    """Ask for one config value through rofi, then write it.

    The panel cannot ask. eww 0.5.0's `focusable` is a single boolean meaning
    *exclusive* keyboard interactivity on a layer surface - a panel that takes
    every key and leaves no way out, which froze the session when it was tried
    - and there is no on-demand setting. So an (input) in the VPN panel
    rendered, accepted clicks, and swallowed every keystroke.

    rofi is an ordinary window and takes the keyboard normally. A key whose
    name looks like a secret is masked, matching how the same value is
    classified when the config is listed.
    """
    secret = "pass" in key.lower() or "key" in key.lower()
    launch = os.environ.get(
        "BW_ROFI", str(Path.home() / ".config/rofi/blackwall/launch"))
    argv = [launch, "compact", "-dmenu", "-p", key]
    if secret:
        argv.append("-password")
    try:
        r = subprocess.run(argv, input="", capture_output=True, text=True)
    except FileNotFoundError:
        return
    value = r.stdout.strip()
    if r.returncode != 0 or not value:
        return
    write_config(path, key, value)


def edit_file(path: str) -> None:
    """Open a root-owned config in the user's editor, in a terminal."""
    term = next((t for t in ("kitty", "foot", "alacritty", "xterm")
                 if shutil.which(t)), None)
    editor = os.environ.get("EDITOR") or next(
        (e for e in ("nvim", "vim", "nano") if shutil.which(e)), "nano")
    if not term:
        run(["notify-send", "-a", "blackwall", "vpn", f"edit {path} by hand"])
        return
    # sudoedit copies the file, edits it as you, and writes it back - so the
    # editor never runs as root, which is the whole point of it existing.
    subprocess.Popen([term, "-e", "sudoedit", path],
                     env={**os.environ, "SUDO_EDITOR": editor,
                          "EDITOR": editor, "VISUAL": editor},
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ------------------------------------------------------------- tailscale ---

def ts_can_switch() -> bool:
    """Whether this user may change profiles without root.

    `tailscale set --operator=$USER` grants it, but the grant belongs to the
    profile it was made on - switching away loses it, and then you cannot
    switch back. That is exactly how this machine ended up logged out with
    `tailscale switch` refusing to run. The panel must know before it offers
    the button.
    """
    code, out, err = run(["tailscale", "switch", "--list"], timeout=6)
    return code == 0 and "access denied" not in (out + err).lower()


def ts_profiles(current_tailnet: str) -> list[dict]:
    """`tailscale switch --list` is a table; the header and any warning lines
    have to be skipped. Warnings appear on stdout when the client and daemon
    versions disagree, which they currently do on this machine."""
    code, out, _ = run(["tailscale", "switch", "--list"])
    if code != 0:
        return []
    profiles = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3 or parts[0] in ("ID", "Warning:") or line.startswith("Warning"):
            continue
        pid, tailnet, account = parts[0], parts[1], " ".join(parts[2:])
        # A trailing asterisk marks the active profile in tailscale's table.
        active = account.endswith("*")
        account = account.rstrip("*")
        # Label from the TAILNET, not the account: one account can hold several
        # tailnets, so labelling by account gives three rows reading
        # "ucha2bokeria" and no way to tell which is which.
        label = tailnet.split("@")[0] if "@" in tailnet else tailnet
        profiles.append({
            "id": pid,
            "tailnet": tailnet,
            "account": account,
            "label": label,
            "sub": account,
            "active": active,
            # An initial for the row's badge. Six tailnets with no mark at all
            # were six lines of text; the widget cannot slice a string (eww has
            # no substring), so it is cut here like every other per-row detail.
            "initial": (label.strip()[:1] or "?").upper(),
        })
    return profiles


def tailscale_state() -> dict:
    if not have("tailscale"):
        return {"present": False}
    code, out, _ = run(["tailscale", "status", "--json"], timeout=6)
    if code != 0 or not out.strip():
        return {"present": True, "up": False, "logged_out": True,
                "can_switch": ts_can_switch(), "login_url": "",
                "profiles": ts_profiles("")}
    try:
        d = json.loads(out)
    except json.JSONDecodeError:
        return {"present": True, "up": False, "profiles": ts_profiles("")}

    me = d.get("Self") or {}
    peers = d.get("Peer") or {}
    online = sum(1 for p in peers.values() if p.get("Online"))
    tx = sum(int(p.get("TxBytes") or 0) for p in peers.values())
    rx = sum(int(p.get("RxBytes") or 0) for p in peers.values())

    exit_node = ""
    for p in peers.values():
        if p.get("ExitNode"):
            exit_node = (p.get("HostName") or "").split(".")[0]
            break

    tailnet = (d.get("CurrentTailnet") or {}).get("Name", "")
    prefs_code, prefs_out, _ = run(["tailscale", "debug", "prefs"], timeout=5)
    dns_on = routes_on = False
    if prefs_code == 0:
        try:
            prefs = json.loads(prefs_out)
            dns_on = bool(prefs.get("CorpDNS"))
            routes_on = bool(prefs.get("RouteAll"))
        except json.JSONDecodeError:
            pass

    return {
        "present": True,
        "up": d.get("BackendState") == "Running",
        "logged_out": d.get("BackendState") == "NeedsLogin",
        "login_url": d.get("AuthURL", ""),
        "can_switch": ts_can_switch(),
        "host": me.get("HostName", ""),
        "ip": (me.get("TailscaleIPs") or [""])[0],
        "tailnet": tailnet,
        "peers": len(peers),
        "online": online,
        "tx": human(tx),
        "rx": human(rx),
        "exit_node": exit_node,
        "dns": dns_on,
        "routes": routes_on,
        "profiles": ts_profiles(tailnet),
    }


def human(n: int) -> str:
    for unit in ("B", "K", "M", "G"):
        if n < 1024 or unit == "G":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}G"


# ----------------------------------------------------- openfortivpn / wg ---

def forti_state() -> dict:
    cfg = Path("/etc/openfortivpn/config")
    if not have("openfortivpn"):
        return {"present": False}
    # Match the process *name*, not its command line.
    #
    # Scanning cmdline counted anything that merely mentioned openfortivpn -
    # including `blackwall-ask sudo ... -- openfortivpn -c ...`, which exists
    # for as long as the password prompt is open. So clicking connect flipped
    # the panel to "connected" the instant the prompt appeared, before any
    # tunnel existed, and the next click tried to disconnect something that
    # was never up. /proc/N/comm is the executable's name and cannot collide
    # with an argument.
    running = False
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if (proc / "comm").read_text().strip() == "openfortivpn":
                running = True
                break
        except OSError:
            continue
    host = ""
    try:
        for line in cfg.read_text().splitlines():
            if line.strip().startswith("host"):
                host = line.split("=", 1)[-1].strip()
                break
    except OSError:
        pass
    return {"present": True, "up": running, "host": host,
            "configured": cfg.exists()}


def wg_state() -> dict:
    if not have("wg"):
        return {"present": False}
    code, out, _ = run(["wg", "show", "interfaces"], timeout=4)
    ifaces = out.split() if code == 0 else []
    return {"present": True, "up": bool(ifaces), "ifaces": ifaces}


def main() -> int:
    argv = sys.argv[1:] or ["status"]
    cmd, rest = argv[0], argv[1:]

    # The prompt verbs block on rofi and the toggles now block on confirm().
    # eww waits for a handler to finish, so either would hold the daemon for
    # as long as a person takes to type or a tunnel takes to come up; detach
    # and let the click return immediately.
    if (cmd.endswith("-prompt") or cmd.endswith("-toggle")) \
            and os.environ.get("BW_DETACHED") != "1":
        env = dict(os.environ, BW_DETACHED="1")
        subprocess.Popen([sys.executable, str(Path(__file__).resolve())] + argv,
                         env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0

    if cmd == "status":
        print(json.dumps({
            "ts": tailscale_state(),
            "forti": forti_state(),
            "wg": wg_state(),
        }))
    elif cmd == "ts-toggle":
        up = bool(tailscale_state().get("up"))
        eww(net_busy="vpn")
        run(["tailscale", "down" if up else "up"], timeout=25)
        confirm("tailscale", not up, lambda: tailscale_state().get("up"), busy="vpn")
    elif cmd == "ts-switch":
        if ts_can_switch():
            run(["tailscale", "switch", rest[0]], timeout=30)
        else:
            # Without operator rights the switch silently fails and can leave
            # the machine logged out, so it is handed to a terminal where the
            # password prompt is visible and the error is readable.
            as_root("switch tailnet", ["tailscale", "switch", rest[0]])
    elif cmd == "ts-login":
        # `tailscale status` prints the URL of the *existing* auth request,
        # and once that request has been consumed or has aged out the browser
        # gets "403: user is not authorized to view this auth request".
        # `tailscale login` mints a fresh one, which is the only URL worth
        # opening.
        code, out, err = run(["tailscale", "login"], timeout=25)
        url = ""
        for line in (out + err).splitlines():
            line = line.strip()
            if line.startswith("https://login.tailscale.com"):
                url = line
                break
        if url:
            run(["xdg-open", url], timeout=5)
        else:
            run(["notify-send", "-a", "blackwall", "tailscale",
                 "could not get a login link - run `tailscale login` in a terminal"])
    elif cmd == "forti-toggle":
        # pkexec needs a polkit agent, and this session runs none - the click
        # went nowhere and said nothing. A terminal shows the password prompt
        # and any error openfortivpn has to report.
        up = bool(forti_state().get("up"))
        # Immediately, so the switch acknowledges the click instead of sitting
        # inert until the tunnel is up.
        eww(net_busy="forti")
        if up:
            as_root("disconnect fortinet vpn", ["pkill", "-x", "openfortivpn"])
        else:
            as_root("fortinet vpn password",
                    ["openfortivpn", "-c", "/etc/openfortivpn/config"])
        confirm("fortinet vpn", not up, lambda: forti_state().get("up"), busy="forti")
    elif cmd == "wg-toggle":
        iface = rest[0] if rest else "wg0"
        up = iface in wg_state().get("ifaces", [])
        eww(net_busy="wg")
        as_root(f"wireguard {iface}", ["wg-quick", "down" if up else "up", iface])
        confirm(f"wireguard {iface}", not up,
                lambda: iface in wg_state().get("ifaces", []), busy="wg")
    elif cmd == "forti-config":
        read_config("/etc/openfortivpn/config")
    elif cmd == "wg-config":
        read_config("/etc/wireguard/wg0.conf")
    elif cmd == "forti-set":
        write_config("/etc/openfortivpn/config", rest[0], " ".join(rest[1:]))
    elif cmd == "wg-set":
        write_config("/etc/wireguard/wg0.conf", rest[0], " ".join(rest[1:]))
    elif cmd == "forti-prompt":
        prompt_set("/etc/openfortivpn/config", rest[0])
    elif cmd == "wg-prompt":
        prompt_set("/etc/wireguard/wg0.conf", rest[0])
    elif cmd == "forti-edit":
        edit_file("/etc/openfortivpn/config")
    elif cmd == "wg-edit":
        edit_file("/etc/wireguard/wg0.conf")
    elif cmd in ("-h", "--help"):
        print(__doc__.strip())
    else:
        print(f"unknown: {cmd}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
