#!/usr/bin/env bash
# Pushes calendar state into eww.
#
# eww's `defpoll` re-runs on a timer, not when a variable inside its command
# changes, so paging to another month cannot be expressed as a poll. Every
# mutation therefore goes through here: do the work, then push the whole new
# state in one `eww update`. That also keeps the widget free of logic - it only
# ever renders what it is handed.
set -uo pipefail

# Detach immediately.
#
# eww waits for a handler command to finish, and this script calls `eww
# update` - so eww is blocked waiting on us while we block waiting on eww.
# The result is a click that does nothing at all: no error, no output, and the
# daemon busy until the request times out. Clicking a date in the calendar,
# picking a month, adding a world clock and toggling bluetooth all failed this
# way, and all of them looked like a broken widget rather than a deadlock.
#
# Re-exec once in a new session and let the parent return straight away.
if [[ "${BW_DETACHED:-}" != 1 ]]; then
    BW_DETACHED=1 setsid "$(readlink -f "$0")" "$@" >/dev/null 2>&1 &
    exit 0
fi

CAL="$(dirname "$(readlink -f "$0")")/blackwall-cal"
EWW="${EWW:-eww}"
# Overridable so the prompt path can be tested without a human at a keyboard:
# point BW_ROFI at anything that prints a line and exits.
LAUNCH="${BW_ROFI:-$HOME/.config/rofi/blackwall/launch}"

# Text entry goes through rofi, not through the panel.
#
# eww 0.5.0's `focusable` is a single boolean and maps to *exclusive* keyboard
# interactivity on a layer surface - a panel that takes every key and leaves no
# way to reach anything else, which froze the whole session when it was tried.
# There is no on-demand setting to ask for instead. So an (input) inside these
# panels can never receive a keystroke: it renders, it accepts clicks, and
# typing goes nowhere.
#
# rofi is an ordinary window and takes the keyboard normally. `-dmenu` with
# nothing on stdin has no entries to match, so Enter returns whatever was
# typed; -filter pre-fills it for editing.
ask() {
    local title="$1" prefill="${2:-}"
    if [[ -n "$prefill" ]]; then
        printf '' | "$LAUNCH" compact -dmenu -p "$title" -filter "$prefill"
    else
        printf '' | "$LAUNCH" compact -dmenu -p "$title"
    fi
}

# No `eww get` anywhere in here. Reading a variable back out of eww from
# inside a handler eww itself launched is a needless round trip, and the month
# is something the widget already knows and can pass.
push() {
    local month="$1" selected="$2"
    "$EWW" update \
        cal_month="$month" \
        cal_selected="$selected" \
        cal_grid="$("$CAL" month "$month")" \
        cal_items="$("$CAL" items "$selected")" \
        cal_note="$("$CAL" note "$selected" | python3 -c 'import json,sys; print(json.load(sys.stdin)["text"])')" \
        cal_boards="$("$CAL" boards)" \
        cal_day="$("$CAL" day "$selected")" \
        cal_picker="$("$CAL" picker "$month")"
}

case "${1:-refresh}" in
    refresh)
        # Opening the panel should land on today, not on wherever it was left
        # three days ago.
        push "$(date +%Y-%m)" "$(date +%F)"
        ;;
    goto)    push "${2:?month}" "${3:-$(date +%F)}" ;;
    pick)
        # Picking a month or year returns to the grid. Doing that as
        # `goto ... && eww update cal_view=month` in the widget meant chaining
        # a shell operator inside an onclick; one verb is one thing to go
        # wrong instead of three.
        push "${2:?month}" "${3:-$(date +%F)}"
        "$EWW" update cal_view=month
        ;;
    open)
        # Padding cells carry no date; clicking one does nothing rather than
        # erroring, which is why the widget passes a literal onclick.
        [[ -n "${2:-}" ]] || exit 0
        push "${3:-$(date +%Y-%m)}" "$2"
        "$EWW" update cal_view=day
        ;;
    note)
        d="${2:?date}"; m="${3:?month}"; shift 3
        "$CAL" note "$d" "$*"
        push "$m" "$d"
        ;;
    push-board)
        "$CAL" push "${2:?date}" "${3:?index}" "${4:?board}"
        notify-send -a blackwall "calendar" "sent to $4"
        ;;
    select)  push "${3:-$(date +%Y-%m)}" "${2:?date}" ;;
    add)
        d="${2:?date}"; m="${3:?month}"; shift 3
        [[ -n "$*" ]] || exit 0
        "$CAL" add "$d" "$*"
        push "$m" "$d"
        ;;
    toggle)
        "$CAL" toggle "${2:?date}" "${3:?index}"
        push "${4:?month}" "$2"
        ;;
    remove)
        "$CAL" remove "${2:?date}" "${3:?index}"
        push "${4:?month}" "$2"
        ;;
    prompt-add)
        d="${2:?date}"; m="${3:?month}"
        text="$(ask "plan for $d")" || exit 0
        [[ -n "$text" ]] || exit 0
        "$CAL" add "$d" "$text"
        push "$m" "$d"
        ;;
    prompt-note)
        d="${2:?date}"; m="${3:?month}"
        text="$(ask "note for $d" "$("$CAL" note "$d" | python3 -c 'import json,sys; print(json.load(sys.stdin)["text"])')")" || exit 0
        "$CAL" note "$d" "$text"
        push "$m" "$d"
        ;;
    *) echo "unknown: $1" >&2; exit 1 ;;
esac
