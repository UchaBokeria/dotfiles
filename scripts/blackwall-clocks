#!/usr/bin/env bash
# Add or remove a world clock and push the new list into eww.
#
# The widget used to chain `zone-find ... && eww update clocks="$(... zones)"`
# inside an onaccept. Command substitution nested in a quoted eww attribute is
# three levels of quoting to get right and it was not getting it right, so the
# input accepted text and nothing happened.
set -uo pipefail

# Detach immediately.
#
# eww waits for a handler command to finish, and this script calls `eww
# update` - so eww is blocked waiting on us while we block waiting on eww.
# The result is a click that does nothing at all: no error, no output, and the
# daemon busy until the request times out. Clicking a date in the calendar,
# picking a month, adding a world clock and toggling bluetooth all failed this
# way, and all of them looked like a broken widget rather than a deadlock.
#
# Re-exec once in a new session and let the parent return straight away.
if [[ "${BW_DETACHED:-}" != 1 ]]; then
    BW_DETACHED=1 setsid "$(readlink -f "$0")" "$@" >/dev/null 2>&1 &
    exit 0
fi

CAL="$(dirname "$(readlink -f "$0")")/blackwall-cal"
EWW="${EWW:-eww}"
# See blackwall-cal-ui for why text entry cannot happen in the panel itself.
LAUNCH="${BW_ROFI:-$HOME/.config/rofi/blackwall/launch}"

refresh() {
    "$EWW" update clocks="$("$CAL" zones)" clock_view=list \
        >/dev/null 2>&1 || true
}

case "${1:-}" in
    add)
        shift
        [[ -n "${*:-}" ]] || exit 0
        "$CAL" zone-find "$*"
        refresh
        ;;
    remove)
        [[ -n "${2:-}" ]] || exit 0
        "$CAL" zone-remove "$2"
        refresh
        ;;
    prompt-add)
        city="$(printf '' | "$LAUNCH" compact -dmenu -p "city")" || exit 0
        [[ -n "$city" ]] || exit 0
        "$CAL" zone-find "$city"
        refresh
        ;;
    refresh) refresh ;;
    *) echo "usage: blackwall-clocks add CITY | prompt-add | remove TZ" >&2; exit 1 ;;
esac
