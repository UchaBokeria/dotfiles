#!/usr/bin/env python3
"""Read the notification history recorded by blackwall-notifyd.

    blackwall-notify history [N]   newest first, as JSON (default 40)
    blackwall-notify count         how many are in the log
    blackwall-notify clear         empty the log
    blackwall-notify dismiss       dismiss what is on screen now
"""
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "blackwall"
LOG = DATA / "notifications.jsonl"


def ago(iso: str) -> str:
    """Relative time, because an absolute one is not what you want here.

    Reading "14:02" forces you to work out what time it is now. "12m" is the
    question you were actually asking.
    """
    try:
        then = datetime.fromisoformat(iso)
    except ValueError:
        return ""
    secs = (datetime.now(then.tzinfo) - then).total_seconds()
    if secs < 60:
        return "now"
    if secs < 3600:
        return f"{int(secs // 60)}m"
    if secs < 86400:
        return f"{int(secs // 3600)}h"
    days = int(secs // 86400)
    return "yesterday" if days == 1 else f"{days}d"


def entries() -> list[dict]:
    try:
        raw = LOG.read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in raw:
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue  # a torn final line from a crash mid-write
    return out


# One glyph per application, chosen here rather than in the widget: eww has no
# user-defined functions, so the alternative was a ten-branch ternary inside
# the markup, and the widget is meant to render what it is handed.
#
# Matched on a substring so "org.gnome.Nautilus" and "nautilus" land together.
# Everything unrecognised gets a bell, which is honest - it says "a
# notification" without pretending to know the source.
#
# Every codepoint here was rendered from SymbolsNerdFont-Regular.ttf and looked
# at before being used. Three of the first guesses were wrong in ways no error
# would ever report: f0326 is a hat rather than a camera, f0d0a a boxed hash
# rather than a send arrow, and f0b0c - which "blackwall" was using - is a
# letter E in a box.
GLYPHS: list[tuple[tuple[str, ...], str]] = [
    (("flameshot", "grim", "screenshot", "spectacle"), "\U000f0100"),   # camera
    (("spotify", "mpd", "mpv", "vlc", "music"), "\U000f075a"),          # music
    (("discord", "slack", "element", "signal"), "\U000f0b79"),          # chat
    (("telegram",), "\U000f048a"),                                      # send
    (("thunderbird", "mail", "evolution", "geary"), "\U000f01ee"),      # envelope
    (("firefox", "chrome", "chromium", "brave", "zen"), "\U000f059f"),  # globe
    (("volume", "pipewire", "pulse", "audio"), "\U000f057e"),           # speaker
    (("network", "nm-applet", "wifi", "bluetooth"), "\U000f05a9"),      # wifi
    (("blackwall",), "\U000f062e"),                                     # tune / rice
    (("notify-send", "system", "systemd"), "\U000f02fc"),               # info
]
FALLBACK_GLYPH = "\U000f009a"                                            # bell


def glyph_for(app: str) -> str:
    low = (app or "").lower()
    for names, g in GLYPHS:
        if any(n in low for n in names):
            return g
    return FALLBACK_GLYPH


def main() -> int:
    argv = sys.argv[1:] or ["history"]
    cmd = argv[0]

    if cmd == "history":
        limit = int(argv[1]) if len(argv) > 1 else 40
        items = entries()[-limit:]
        items.reverse()
        # The index travels with the entry: eww's `for` has no counter, and a
        # row needs to know which entry it is to dismiss it.
        print(json.dumps([{
            "i": i,
            "app": e.get("app", ""),
            "summary": e.get("summary", ""),
            "body": " ".join((e.get("body") or "").split())[:120],
            "urgency": e.get("urgency", "normal"),
            "ago": ago(e.get("ts", "")),
            "glyph": glyph_for(e.get("app", "")),
        } for i, e in enumerate(items)]))
    elif cmd == "count":
        print(len(entries()))
    elif cmd == "clear":
        LOG.parent.mkdir(parents=True, exist_ok=True)
        LOG.write_text("")
    elif cmd == "dismiss":
        # Whichever daemon is running. swaync and mako both own the
        # notification bus, so exactly one of these does anything.
        for c in (["swaync-client", "-cp"], ["makoctl", "dismiss", "-a"]):
            try:
                subprocess.run(c, check=False, capture_output=True)
            except (FileNotFoundError, OSError):
                pass
    elif cmd == "drop":
        # Remove one entry from the history by index (newest first), so a
        # single notification can be cleared without wiping the lot.
        idx = int(argv[1])
        items = entries()
        target = len(items) - 1 - idx
        if 0 <= target < len(items):
            del items[target]
            LOG.parent.mkdir(parents=True, exist_ok=True)
            LOG.write_text("".join(json.dumps(e, ensure_ascii=False) + "\n"
                                   for e in items))
    elif cmd in ("-h", "--help"):
        print(__doc__.strip())
    else:
        print(f"unknown: {cmd}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
