* {
  bg: #0b0f14;
  bg-alt: #111827;
  fg: #e5e7eb;
  muted: #9ca3af;
  accent: #38bdf8;

  background-color: transparent;
  text-color: @fg;
}

window {
  width: 520px;
  border-radius: 16px;
  border: 2px;
  border-color: @accent;
  background-color: @bg;
}

mainbox {
  padding: 14px;
  spacing: 10px;
}

inputbar {
  padding: 12px;
  border-radius: 10px;
  background-color: @bg-alt;
  text-color: @fg;
}

prompt {
  text-color: @muted;
}

entry {
  placeholder: "Search…";
  placeholder-color: @muted;
}

listview {
  lines: 6;
  spacing: 6px;
}

element {
  padding: 10px;
  border-radius: 10px;
}

element selected {
  background-color: @accent;
  text-color: #000000;
}

element-text {
  highlight: bold underline;
}

element-icon {
  size: 24px;
}
