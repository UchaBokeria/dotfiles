/* blackwall - the screenshot history browser (SUPER+CTRL+V).
 *
 * Layout only; every colour comes from ../shared/blackwall.rasi.
 *
 * Separate from wall.rasi because the content is a different shape. Wallpapers
 * are a library you browse; screenshots are a stack you reach back into, so
 * this is ordered newest-first and the tiles are wide rather than square - a
 * 16:9 capture in a square tile is mostly empty tile.
 */

@import "../shared/blackwall.rasi"

configuration {
    show-icons: true;
}

/* Fill, rim, radius and padding all come from the shared shell now. They were
   restated here as 20px padding and 16/12px gaps, which is how three launchers
   built on "one look" ended up with three different paddings. */
window {
    location: center;
    anchor:   center;
    width:    72%;
    height:   76%;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

inputbar {
    margin: 0px 30%;
}

listview {
    columns:      3;
    lines:        2;
    spacing:      @bw-s-lg;
    scrollbar:    true;
    fixed-height: false;
    dynamic:      false;
}

/* Tile selection is the same in all three tile launchers (this, the
   wallpaper picker and the app grid): an accent tint with an accent rim. A
   solid accent fill behind a picture reads as a frame on the picture. The
   transparent border keeps a tile from growing a pixel when selected. */
element {
    orientation:      vertical;
    spacing:          @bw-s-md;
    padding:          @bw-s-md;
    border:           1px;
    border-color:     transparent;
    border-radius:    @bw-r-md;
    background-color: @bw-raised-lo;
}

element selected.normal {
    background-color: @bw-accent-lo;
    border-color:     @bw-accent-edge;
    text-color:       @bw-fg;
}

/* Wide, not square: these are screen captures, so the tile should have the
   proportions of a screen. */
element-icon {
    size:             200px;
    expand:           true;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    expand:           false;
    text-color:       @bw-muted;
    font:             "Inter 10";
}

element selected.normal element-text {
    text-color: @bw-fg;
}
