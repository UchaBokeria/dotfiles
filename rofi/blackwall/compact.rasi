/* blackwall - the compact picker.
 *
 * Layout only; see ../shared/blackwall.rasi. A narrower, shorter list for
 * quick single-purpose pickers where a full launcher would be oversized -
 * clipboard history, wallpaper picking, archpilot's session list.
 */

@import "../shared/blackwall.rasi"

configuration {
    modi:                "drun,run";
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";
}

window {
    location: center;
    anchor:   center;
    width:    520px;
    y-offset: -80px;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

listview {
    lines:        7;
    columns:      1;
    fixed-height: false;
}

element-icon {
    size: 20px;
}
