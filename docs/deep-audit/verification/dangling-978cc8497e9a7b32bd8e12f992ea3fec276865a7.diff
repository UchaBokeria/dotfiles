+        # are turned into spaces, the way scan_for reads them.
+        if [[ -n "$pid" && -d "/proc/$pid" ]] \
+                && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qsF -- "$2"; then
+            return 0
         fi
     fi
