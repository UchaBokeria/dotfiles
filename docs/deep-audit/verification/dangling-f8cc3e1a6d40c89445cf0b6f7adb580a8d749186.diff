-if python3 -c 'import json,os,sys; p=os.path.expanduser("~/.config/swaync/config.json"); sys.exit(0 if "blackwall-dnd" not in json.load(open(p)).get("notification-visibility", {}) else 1)'
+if python3 -c 'import json,os,sys; p=os.path.expanduser("~/.config/swaync/config.json"); sys.exit(0 if "blackwall-dnd" not in json.load(open(p))["notification-visibility"] else 1)'
   then ok "dnd rule lifted with dnd"
   else no "dnd rule lifted" "still present"; fi
