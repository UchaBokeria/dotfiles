-# This changes the real setting; remember it so a run does not leave do-not-
-# disturb off for someone who had it on.
-dnd_before="$($B/blackwall-quiet dnd-state 2>/dev/null)"
-# Put it back however this ends: an interrupt between "on" and the restore below
-# used to leave do-not-disturb flipped for good. `dnd` runs detached, so it
-# outlives this shell.
-restore_dnd() {
-  [[ "$dnd_before" == true || "$dnd_before" == false ]] || return 0
-  [[ "$($B/blackwall-quiet dnd-state 2>/dev/null)" == "$dnd_before" ]] && return 0
-  $B/blackwall-quiet dnd "$([[ "$dnd_before" == true ]] && echo on || echo off)" >/dev/null 2>&1
-}
-trap 'restore_dnd' EXIT
-trap 'exit 130' INT TERM
 $B/blackwall-quiet dnd on >/dev/null 2>&1;  val "do not disturb on"  notif_dnd true
 # The setting alone is not enough: swaync lets Critical through DND on its
@@ -90,12 +77,11 @@
 # the part that actually silences the screen, so assert it exists while DND is
 # on and is gone once it is off.
-if python3 -c 'import json,os,sys; p=os.path.expanduser("~/.config/swaync/config.json"); sys.exit(0 if "blackwall-dnd" in json.load(open(p)).get("notification-visibility", {}) else 1)'
+if python3 -c 'import json,os,sys; p=os.path.expanduser("~/.config/swaync/config.json"); sys.exit(0 if "blackwall-dnd" in json.load(open(p))["notification-visibility"] else 1)'
   then ok "do not disturb silences critical too"
   else no "dnd silence rule" "missing while dnd is on"; fi
