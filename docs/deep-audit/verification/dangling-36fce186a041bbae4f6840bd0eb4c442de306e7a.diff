-        if [[ "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]]; then
-            cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
-            [[ "$cmdline" == *"$2"* ]] && return 0
+        if [[ -n "$pid" && -d "/proc/$pid" ]] && grep -qs "$2" "/proc/$pid/cmdline"; then
+            return 0
         fi
     fi
