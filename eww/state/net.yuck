;; Network state.
;;
;; One poll for the whole thing rather than four. The old version ran four
;; separate scripts every second while the panel was open, each shelling out to
;; nmcli - four processes a second to render four short strings. This asks once
;; and returns a single JSON blob that the panel destructures.
;;
;; The lists are polled separately and only while their section is expanded: a
;; wifi scan is not free, and there is no reason to run one when nobody is
;; looking at the list.

(defvar net_expanded "")

(defpoll net_status
  :initial `{"wifi":{"on":false,"ssid":"","signal":0},"eth":{"on":false,"name":""},"vpn":{"on":false,"name":"","ip":""},"bt":{"on":false,"connected":""}}`
  :interval "5s"
  :run-while is_network_open
  `~/.config/.dotfiles/blackwall/scripts/blackwall-net status`)

(defpoll net_wifi_list
  :initial "[]"
  :interval "15s"
  :run-while {is_network_open && net_expanded == "wifi"}
  `~/.config/.dotfiles/blackwall/scripts/blackwall-net wifi-list`)

(defpoll net_bt_list
  :initial "[]"
  :interval "10s"
  :run-while {is_network_open && net_expanded == "bt"}
  `~/.config/.dotfiles/blackwall/scripts/blackwall-net bt-list`)
