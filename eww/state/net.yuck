(defpoll get_tunnel
  :inital "Scanning.."
  :interval "1s" 
  :run-while is_control_center_open
  `scripts/net/get_tunnel`) 

(defpoll get_vpn
  :inital "Scanning.."
  :interval "1s" 
  :run-while is_control_center_open
  `scripts/net/get_vpn`) 

(defpoll get_wifi
  :inital "Scanning.."
  :interval "1s" 
  :run-while is_control_center_open
  `scripts/net/get_wifi`) 

(defpoll get_bluetooth
  :inital "Scanning.."
  :interval "1s" 
  :run-while is_control_center_open
  `scripts/net/get_bluetooth`) 
