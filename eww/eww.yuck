(defwidget music []
  (box :class "music"
    (label :text (script "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || echo 'No player'"))))

(defwindow musicwin
  :monitor 0
  :geometry (geometry :x "20px" :y "60px" :width "420px" :height "40px" :anchor "top left")
  :stacking "overlay"
  :focusable false
  :exclusive false
  (music))
