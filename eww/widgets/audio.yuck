;; Advanced audio: levels, devices and per-application volume.
;;
;; This was a placeholder reading "Audio Ok". The control centre keeps the two
;; sliders you reach for constantly; everything you only occasionally need -
;; which output, which input, and which app is too loud - lives here, behind
;; the waybar volume icon.

(defwidget app_stream [entry]
  (box :class "app-row" :orientation "v" :space-evenly false :spacing 4
    (box :orientation "h" :space-evenly false :spacing 8
      (eventbox :cursor "hand2"
        (button :class "vol-icon ${entry.mute ? "silent" : ""}"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-audio app-mute ${entry.id}"
          {entry.mute ? "󰝟" : "󰕾"}))
      (box :orientation "v" :space-evenly false :hexpand true
        (label :class "app-name" :text {entry.app} :xalign 0 :limit-width 24)
        (label :class "app-media" :text {entry.media} :xalign 0 :limit-width 32
               :visible {entry.media != ""}))
      (label :class "vol-level" :text "${entry.vol}%" :xalign 1))
    (eventbox :cursor "hand2"
      (scale :class "vol-scale"
             :min 0 :max 100 :round 2
             :value {entry.vol > 100 ? 100 : entry.vol}
             :draw-value false
             :onchange "~/.config/.dotfiles/blackwall/scripts/blackwall-audio app-volume ${entry.id} {}"))))

(defwindow audio
  :monitor 0
  :stacking "fg"
  :windowtype "dialog"
  :namespace "eww_wifi"
  :geometry (geometry :anchor "top right" :x "22px" :y "22px" :width "390px")

  (box :class "bar-window"
    (box :class "bar-widget" :orientation "v" :space-evenly false :spacing 12

      ;; Output and input, each with its device picker already reachable.
      (control_center_ios :title "levels")

      (box :orientation "v" :space-evenly false :spacing 8
           :class "bar-widget-section"
        (label :class "section-title" :text "playing" :halign "start")

        ;; MPRIS first: it survives a pause, so this row keeps showing the
        ;; track when the stream underneath it has gone away.
        (box :class "now-playing" :orientation "h" :space-evenly false :spacing 10
             :visible {audio_media.has}
          (box :orientation "v" :space-evenly false :hexpand true
            (label :class "np-title" :text {audio_media.title} :xalign 0 :limit-width 30)
            (label :class "np-sub" :xalign 0 :limit-width 34
                   :text {audio_media.artist != ""
                          ? "${audio_media.artist} · ${audio_media.status}"
                          : "${audio_media.player} · ${audio_media.status}"}))
          (eventbox :cursor "hand2"
            (button :class "np-btn" :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-audio media-prev" "󰒮"))
          (eventbox :cursor "hand2"
            (button :class "np-btn accent"
                    :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-audio media-play"
              {audio_media.playing ? "󰏤" : "󰐊"}))
          (eventbox :cursor "hand2"
            (button :class "np-btn" :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-audio media-next" "󰒭")))

        (label :class "cal-empty" :halign "start"
               :text {audio_media.has ? "no app is holding a stream right now"
                                      : "nothing is playing"}
               :visible {arraylength(audio_apps) == 0})

        ;; Per-app volume - the half of pavucontrol anyone actually opens it
        ;; for. One app being too loud is not a reason to turn everything down.
        (box :orientation "v" :space-evenly false :spacing 8
          (for entry in audio_apps (app_stream :entry entry)))))))
