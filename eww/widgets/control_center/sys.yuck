
(defwidget control_center_sys [?cpu ?ram ?storage ?net]
  (box
      :name "sys"
      :height "300px"
      :orientation "horizontal"
      :class "bar-widget-section sys"

    (box :orientation "v"
      "󰘚 CPU ${round(cpu, 0)}%"

      (circular-progress
        :thickness 30
        :clickwise true
        :start-at 0
        :value cpu
      )
    )

    (box :orientation "v"
      "󰍛 RAM ${round(ram, 0)}%"

      (circular-progress
        :thickness 10
        :clickwise true
        :start-at 0
        :value ram
      )
    )

    (box :orientation "v"
      "󰆼 Disk ${round(storage, 0)}%"

      (circular-progress
        :thickness 10
        :clickwise true
        :start-at 0
        :value storage
      )
    )

    (box :orientation "v"
      "󰲝 Net ${round(net / 1024, 0)} KB/s"

      (label :markup net_graph
        :style "padding-left: 20px;"
        :halign "start"   ;; ← horizontal start
        )

    )
  )
)

