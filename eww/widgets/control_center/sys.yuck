(defwidget control_center_sys [?cpu ?ram ?storage ?net]
  (box
      :name "sys"
      :height "300px"
      :orientation "horizontal"
      :class "bar-widget-section sys"

    (box :orientation "v"
      "󰘚 ${round(cpu, 0)}%"

      (circular-progress
        :thickness 10
        :clickwise true
        :start-at 0
        :value cpu
      )
    )

    (box :orientation "v"
      "󰍛 ${round(ram, 0)}%"

      (circular-progress
        :thickness 10
        :clickwise true
        :start-at 0
        :value ram
      )
    )

    (box :orientation "v"
      "󰆼 ${round(storage, 0)}%"

      (circular-progress
        :thickness 10
        :clickwise true
        :start-at 0
        :value storage
      )
    )

    (box :orientation "v"
      "󰲝 ${round(net, 0)}%"

      (circular-progress
        :thickness 10
        :clickwise true
        :start-at 0
        :value net
      )
    )
  )
)

