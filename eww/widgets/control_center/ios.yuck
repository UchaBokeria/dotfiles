(include "state/ios.yuck")

(defwidget control_center_ios []
    (box 
        :name "ios container"
        :orientation "vertical"
        :space-evenly false
        :spacing 10
        :class "bar-widget-section ios"

      (box 
        :name "vol control" 
        :class "vol" 
        :orientation "horizontal" 
        :space-evenly false
        :spacing 10
        

        (box
          :width 50
          :space-evenly false
          (label 
            :text "󰕾 "
          )

          (label 
            :text "${round(get_vol, 0)}%"
            :xalign 0
            :width 24
          )
        )

        (eventbox :cursor "hand2"
                  :hexpand true
          (scale
            :value-pos "right"
            :marks "O"
            :min 0
            :max 100
            :round 2
            :value get_vol
            :draw-value false
            :hexpand true
            :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"
          )
        )
      )

      (box 
        :name "vol control" 
        :class "vol" 
        :orientation "horizontal" 
        :space-evenly false
        :spacing 10
        

        (box
          :width 50
          :space-evenly false
          (label 
            :text "󰍬 "
            :xalign 0
            :width 0
          )

          (label 
            :text "${round(get_mic, 0)}%"
            :width 24
          )
        )

        (eventbox :cursor "hand2"
                  :hexpand true
          (scale
            :value-pos "right"
            :marks "O"
            :min 0
            :max 100
            :round 2
            :value get_mic
            :draw-value false
            :hexpand true
            :onchange "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {}%"
          )
        )
      )

      (box 
        :name "vol control" 
        :class "vol" 
        :spacing 10
        :orientation "horizontal"
        :space-evenly false
        
        (box
          :width 50
          :space-evenly false
          (label 
            :xalign 0
            :text "󰃠 "
          )

          (label 
            :xalign 0
            :width 24
            :text "${round(get_dim, 0)}%"
          )
        )

        (eventbox :cursor "hand2" 
                  :hexpand true 
          (scale
            :value-pos "right"
            :marks "O"
            :min 0
            :max 100
            :round 2
            :value get_dim
            :draw-value false
            :onchange "sh -c '
              eww update get_dim=\"$1\"; ddcutil -d 1 setvcp 10 \"$1\";
            ' _ {}"
          )
        )
      )
  )
)

