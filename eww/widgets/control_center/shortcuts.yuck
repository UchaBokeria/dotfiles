;; Quick actions.
;;
;; These were bare glyphs on a transparent row with no stylesheet at all - five
;; symbols floating in a box, with nothing to say they were buttons or what
;; they did. Each is a labelled tile now: the glyph reads at a glance and the
;; word underneath removes the guessing.

(defvar nightmode false)

(defwidget shortcut [icon label onclick ?active]
  (eventbox :onclick onclick :cursor "hand2" :hexpand true
    (button :class "shortcut ${active ?: false ? "on" : ""}"
            
            :hexpand true
      (box :orientation "v" :space-evenly false :spacing 5 :halign "center"
        (label :class "shortcut-icon" :text icon)
        (label :class "shortcut-label" :text label)))))

(defwidget control_center_shortcuts []
  (box :orientation "v" :space-evenly false :spacing 8
       :class "bar-widget-section"

    (label :class "section-title" :xalign 0 :text "quick actions" :hexpand true)

    (box :orientation "h" :space-evenly true :spacing 6
      (shortcut :icon {nightmode ? "󰖙" : "󰖔"}
                :label {nightmode ? "day" : "night"}
                :active nightmode
                :onclick "~/.config/eww/scripts/nightmode")
      (shortcut :icon "󰅌" :label "clipboard"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-clip")
      (shortcut :icon "󰄀" :label "capture"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-shot region --edit &")
      (shortcut :icon "󰻃" :label "record"
                :onclick "~/.config/eww/scripts/screen_recording &")
      (shortcut :icon "󰐥" :label "power"
                :onclick "~/.config/wlogout/launch &"))))
