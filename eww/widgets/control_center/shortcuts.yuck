; (defpoll nightmode :interval "2s"
;   `pgrep -x hyprsunset >/dev/null && echo true || echo false`)

(defvar nightmode false)

(defwidget control_center_shortcuts [?]
  (box
      :name "shortcuts"
      :height "300px"
      :orientation "horizontal"
      :class "bar-widget-section shortcuts"

    (eventbox :cursor "hand2"
      (button :onclick "~/.config/eww/scripts/nightmode"
        (label :class "shortcut-btn" :text {nightmode ? "󰖙" : "󰖔"})
      )
    )

    (eventbox :cursor "hand2"
      (button :onclick "cliphist list | rofi -dmenu | cliphist decode | wl-copy"
        (label :class "shortcut-btn" :text "󰅌")
      )
    )

    (eventbox :cursor "hand2"
      (button :onclick "flameshot gui &"
        (label :class "shortcut-btn" :text "")
      )
    )

    (eventbox :cursor "hand2"
      (button :onclick "~/.config/eww/scripts/screen_recording &"
        (label :class "shortcut-btn" :text "󰻃")
      )
    )

    (eventbox :cursor "hand2"
      (button :onclick "wlogout -p layer-shell &"
        (label :class "shortcut-btn" :text "󰐥")
      )
    )

  )
)

