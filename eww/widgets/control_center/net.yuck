(include "state/net.yuck")

(defwidget control_center_net []
  (box
      :name "net"
      :orientation "horizontal"
      :class "bar-widget-section net"
    (box 
      "󰌾 ${get_tunnel}"
    )
    (box 
      "󰒃 ${get_vpn}"
    )
    (box 
      "󰖩 ${get_wifi}"
    )
    (box 
      "󰂯 ${get_bluetooth}"
    )
  )
)

