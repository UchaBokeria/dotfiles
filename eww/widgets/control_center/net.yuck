(include "state/net.yuck")

(defwidget control_center_net []
  (box
      :name "net"
      :orientation "horizontal"
      :class "bar-widget-section net"

    (eventbox :cursor "hand2"
      (box 
        "󰌾 ${get_tunnel}"
      )
    )

    (eventbox :cursor "hand2"
      (box 
        "󰒃 ${get_vpn}"
      )
    )

    (eventbox :cursor "hand2"
      (box 
        "󰖩 ${get_wifi}"
      )
    )

    (eventbox :cursor "hand2"
      (box 
        "󰂯 ${get_bluetooth}"
      )
    )
  )
)

