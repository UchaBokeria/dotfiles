;; Network, VPN and bluetooth as one pane.
;;
;; This replaces four labels that showed state and did nothing when clicked.
;; Each row is now a control: the left button toggles the radio, the body
;; expands a list you can act on. Only one section is open at a time - two open
;; lists make the panel taller than the screen and neither is easier to read.
;;
;; VPN here is Tailscale, because that is what is actually running on this
;; machine; NetworkManager has no VPN profiles configured at all.

(include "state/net.yuck")

(defwidget net_row [icon title subtitle active ?onclick ?section]
  (box :class "net-row ${active ? "on" : ""}"
       :orientation "h"
       :space-evenly false
       :spacing 12

    (eventbox :cursor "hand2"
      (button :class "net-toggle ${active ? "on" : ""} ${net_busy == (section != "" ? section : icon) ? "busy" : ""}"
              :onclick {onclick ?: ""}
        icon))

    (eventbox :cursor "hand2" :hexpand true
      (button :class "net-body"
              :hexpand true
              :onclick {section != "" ? "eww update net_view=${section}" : ""}
        (box :orientation "v" :space-evenly false :halign "start"
          (label :class "net-title" :text title :halign "start" :limit-width 26)
          (label :class "net-sub" :text subtitle :halign "start"
                 :limit-width 30))))))

(defwidget wifi_entry [entry]
  ;; Left click connects, right click opens the actions menu - show or copy the
  ;; saved password, share by QR, copy the MAC, forget the network. "locked"
  ;; told you nothing you could not guess; the security generation and band do.
  (eventbox :cursor "hand2"
            :onrightclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net wifi-menu '${entry.ssid}'"
    (button :class "list-row ${entry.active ? "on" : ""}"
            :tooltip "${entry.sec_detail} · channel ${entry.chan} · ${entry.bssid}"
            :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui wifi-connect '${entry.ssid}'"
      (box :orientation "h" :space-evenly false :spacing 10
        (label :class "list-mark" :text {net_busy == "wifi:${entry.ssid}" ? "◌"
                                         : (entry.active ? "●" : "○")})
        (box :orientation "v" :space-evenly false :hexpand true
          (label :class "list-name" :text {entry.ssid} :xalign 0 :limit-width 24)
          (label :class "list-meta" :xalign 0
                 :text {entry.saved ? "${entry.sec} · ${entry.band} · saved"
                                    : "${entry.sec} · ${entry.band}"}))
        (label :class "list-meta mono" :text "${entry.signal}%")))))

(defwidget bt_entry [entry]
  (eventbox :cursor "hand2"
    (button :class "list-row ${entry.connected ? "on" : ""}"
            :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui bt-${entry.connected ? "disconnect" : "connect"} ${entry.mac}"
      (box :orientation "h" :space-evenly false :spacing 10
        (label :class "list-mark" :text {net_busy == "bt:${entry.mac}" ? "◌"
                                         : (entry.connected ? "●" : "○")})
        (label :class "list-name" :text {entry.name} :hexpand true
               :halign "start" :limit-width 26)
        (label :class "list-meta"
               :text {net_busy == "bt:${entry.mac}"
                      ? (entry.connected ? "disconnecting" : "connecting")
                      : (entry.connected ? "connected" : "")})))))

(defwidget net_back [title]
  (box :class "net-back-row" :orientation "h" :space-evenly false :spacing 8
    (eventbox :cursor "hand2"
      (button :class "net-back" :onclick "eww update net_view=''" "‹"))
    (label :class "net-back-title" :text title :xalign 0 :hexpand true)))

(defwidget control_center_net [?class]
  (box :orientation "v"
       :space-evenly false
       :spacing 8
       :class {class ?: "bar-widget-section"}

    ;; ---- the list of rows, when nothing is drilled into ----
    (box :orientation "v" :space-evenly false :spacing 8
         :visible {net_view == ""}

      (label :class "section-title" :xalign 0 :text "network" :hexpand true)

      (net_row :icon "wifi"
               :title {net_status.wifi.ssid != "" ? net_status.wifi.ssid : "wi-fi"}
               :subtitle {net_status.wifi.on
                          ? (net_status.wifi.ssid != ""
                             ? "connected · ${net_status.wifi.signal}%"
                             : "on · not connected")
                          : "off"}
               :active {net_status.wifi.on}
               :section "wifi"
               :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui wifi-toggle")

      (net_row :icon "eth"
               :title {net_status.eth.on ? net_status.eth.name : "ethernet"}
               :subtitle {net_status.eth.on ? "connected" : "unplugged"}
               :active {net_status.eth.on}
               :section "")

      (net_row :icon "vpn"
               :title {vpn_status.ts.up && vpn_status.ts.tailnet != ""
                       ? vpn_status.ts.tailnet : "vpn"}
               :subtitle {vpn_status.ts.up
                          ? "${vpn_status.ts.ip} · ${vpn_status.ts.online}/${vpn_status.ts.peers} peers"
                          : "off"}
               :active {vpn_status.ts.up}
               :section "vpn")

      (net_row :icon "bt"
               :title "bluetooth"
               :subtitle {net_status.bt.on
                          ? (net_status.bt.connected != ""
                             ? net_status.bt.connected : "on · nothing connected")
                          : "off"}
               :active {net_status.bt.on}
               :section "bt"
               :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui bt-toggle"))

    ;; ---- wi-fi ----
    (box :orientation "v" :space-evenly false :spacing 6 :visible {net_view == "wifi"}
      (net_back :title "wi-fi")
      (scroll :height 420 :vscroll true :hscroll false
        (box :orientation "v" :space-evenly false :spacing 2
          (for entry in net_wifi_list (wifi_entry :entry entry)))))

    ;; ---- bluetooth ----
    (box :orientation "v" :space-evenly false :spacing 6 :visible {net_view == "bt"}
      (net_back :title "bluetooth")
      (scroll :height 380 :vscroll true :hscroll false
        (box :orientation "v" :space-evenly false :spacing 2
          (for entry in net_bt_list (bt_entry :entry entry))
          (eventbox :cursor "hand2"
            (button :class "list-row"
                    :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui bt-scan"
              (label :class "list-name"
                     :text {net_busy == "scan" ? "scanning for devices" : "scan for devices"}
                     :xalign 0))))))

    ;; ---- vpn ----
    (box :orientation "v" :space-evenly false :spacing 6 :visible {net_view == "vpn"}
      (net_back :title "vpn")
      (vpn_panel))))
