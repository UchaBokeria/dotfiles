;; VPN, across every backend on this machine.
;;
;; The row used to read "tailscale · 3 peers" and toggle up/down. That is fine
;; with one tailnet and useless with six: the one thing you need to know is
;; *whose* network you are on, and the one thing you need to do is change it.

(defwidget vpn_tab_btn [id label enabled]
  (eventbox :onclick {enabled ? "eww update vpn_tab=${id}" : ""} :cursor {enabled ? "hand2" : "default"}
    (button :class "vpn-tab ${vpn_tab == id ? "on" : ""} ${enabled ? "" : "off"}"
            
      label)))

(defwidget vpn_stat [label value]
  (box :orientation "v" :space-evenly false :hexpand true
    (label :class "vpn-stat-value" :text value :xalign 0)
    (label :class "vpn-stat-label" :text label :xalign 0)))

(defwidget vpn_profile [entry]
  (eventbox :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui vpn-switch ${entry.id}" :cursor "hand2"
    (button :class "list-row ${entry.active ? "on" : ""}"
            
      (box :orientation "h" :space-evenly false :spacing 10
        (label :class "list-mark" :text {net_busy == "vpn:${entry.id}" ? "◌"
                                          : (entry.active ? "●" : "○")})
        (box :orientation "v" :space-evenly false :hexpand true
          (label :class "list-name" :text {entry.label} :xalign 0 :limit-width 26)
          (label :class "list-meta" :text {entry.sub} :xalign 0 :limit-width 30))))))

(defwidget vpn_toggle_row [label state onclick]
  (box :class "vpn-opt" :orientation "h" :space-evenly false :spacing 8
    (label :class "list-name" :text label :xalign 0 :hexpand true)
    (eventbox :onclick onclick :cursor "hand2"
      (button :class "vpn-switch ${state ? "on" : ""}" 
        {state ? "on" : "off"}))))

(defwidget vpn_field [field backend]
  ;; Secrets are never read back out of the file, so the box is blank and
  ;; typing into it sets a new one. Showing a password you already have adds
  ;; nothing and printing it into a widget tree is a way to leak it.
  (box :class "vpn-field" :orientation "v" :space-evenly false :spacing 3
    (label :class "vpn-field-key" :text {field.key} :xalign 0)
    (input :class "cal-input"
           :password {field.secret}
           :value {field.value}
           :onaccept "~/.config/.dotfiles/blackwall/scripts/blackwall-vpn ${backend}-set ${field.key} {}")))

(defwidget vpn_config [cfg backend]
  (box :orientation "v" :space-evenly false :spacing 8
    (box :orientation "h" :space-evenly false :spacing 6
      (label :class "section-title" :xalign 0 :text "configuration" :hexpand true)
      (eventbox :onclick "eww update vpn_cfg_open=${vpn_cfg_open == backend ? "-" : backend}" :cursor "hand2"
        (button :class "notif-tool"
                
          {vpn_cfg_open == backend ? "󰅖" : "󰒓"})))

    (for _ in {vpn_cfg_open == backend ? [1] : []}
      (box :orientation "v" :space-evenly false :spacing 8
        (for f in {cfg.fields} (vpn_field :field f :backend backend))
        (label :class "cal-empty-hint" :xalign 0 :wrap true
               :text "press enter in a field to save it; the file is root-owned so you will be asked for your password")))))

(defwidget vpn_panel []
  (box :orientation "v" :space-evenly false :spacing 10

    ;; Tabs. A backend that is not installed is shown but dimmed, so the panel
    ;; says what it could do rather than hiding it.
    (box :class "vpn-tabs" :orientation "h" :space-evenly true :spacing 4
      (vpn_tab_btn :id "tailscale" :label "tailscale" :enabled {vpn_status.ts.present})
      (vpn_tab_btn :id "forti" :label "fortinet" :enabled {vpn_status.forti.present})
      (vpn_tab_btn :id "wg" :label "wireguard" :enabled {vpn_status.wg.present}))

    ;; ---- tailscale ----
    (box :orientation "v" :space-evenly false :spacing 10
         :visible {vpn_tab == "tailscale" && vpn_status.ts.present}

      (box :class "vpn-head" :orientation "h" :space-evenly false :spacing 10
        (box :orientation "v" :space-evenly false :hexpand true
          (label :class "net-title" :text {vpn_status.ts.tailnet != ""
                                            ? vpn_status.ts.tailnet : "signed out"}
                 :xalign 0 :limit-width 26)
          (label :class "net-sub" :text {vpn_status.ts.up
                                          ? "${vpn_status.ts.host} · ${vpn_status.ts.ip}"
                                          : "not connected"} :xalign 0 :limit-width 32))
        (eventbox :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui vpn-toggle" :cursor "hand2"
          (button :class "net-toggle ${vpn_status.ts.up ? "on" : ""} ${net_busy == "vpn" ? "busy" : ""}"
                  
            "vpn")))

      ;; Tailscale authenticates in a browser. The CLI prints a URL and
      ;; nothing was surfacing it, so a signed-out machine looked simply
      ;; broken.
      (box :class "vpn-notice" :orientation "v" :space-evenly false :spacing 8
           :visible {vpn_status.ts.logged_out}
        (label :class "net-sub" :xalign 0 :wrap true
               :text "this machine is signed out of tailscale")
        (eventbox :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-vpn ts-login" :cursor "hand2"
          (button :class "cal-foot-btn"
                  
            "sign in with a browser")))

      (box :class "vpn-stats" :orientation "h" :space-evenly true
           :visible {vpn_status.ts.up}
        (vpn_stat :label "peers" :value "${vpn_status.ts.online}/${vpn_status.ts.peers}")
        (vpn_stat :label "sent" :value {vpn_status.ts.tx})
        (vpn_stat :label "received" :value {vpn_status.ts.rx})
        (vpn_stat :label "exit node" :value {vpn_status.ts.exit_node != ""
                                              ? vpn_status.ts.exit_node : "none"}))

      (box :orientation "v" :space-evenly false :spacing 4 :visible {vpn_status.ts.up}
        (vpn_toggle_row :label "use tailnet DNS" :state {vpn_status.ts.dns}
                        :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui vpn-dns ${vpn_status.ts.dns ? "off" : "on"}")
        (vpn_toggle_row :label "accept subnet routes" :state {vpn_status.ts.routes}
                        :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-net-ui vpn-routes ${vpn_status.ts.routes ? "off" : "on"}"))

      (label :class "section-title" :xalign 0 :text "tailnets" :hexpand true
             :visible {arraylength(vpn_status.ts.profiles) > 0})
      (box :orientation "v" :space-evenly false :spacing 2 :class "net-list"
        (for entry in {vpn_status.ts.profiles} (vpn_profile :entry entry)))

      ;; Switching profiles needs operator rights, and the grant belongs to
      ;; the profile it was made on - so switching away can lose it and leave
      ;; you unable to switch back. Saying so beats a button that fails.
      (box :class "vpn-notice" :orientation "v" :space-evenly false :spacing 6
           :visible {!vpn_status.ts.can_switch}
        (label :class "net-sub" :xalign 0 :wrap true
               :text "changing tailnet needs root on this machine - the switch opens a terminal")
        (label :class "cal-empty-hint" :xalign 0 :wrap true
               :text "run  sudo tailscale set --operator=$USER  once per profile to avoid that")))

    ;; ---- openfortivpn ----
    (box :orientation "v" :space-evenly false :spacing 8
         :visible {vpn_tab == "forti" && vpn_status.forti.present}
      (box :class "vpn-head" :orientation "h" :space-evenly false :spacing 10
        (box :orientation "v" :space-evenly false :hexpand true
          (label :class "net-title" :text {vpn_status.forti.host != ""
                                            ? vpn_status.forti.host : "openfortivpn"}
                 :xalign 0 :limit-width 28)
          (label :class "net-sub" :xalign 0
                 :text {vpn_status.forti.up ? "connected" : "not connected"}))
        (eventbox :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-vpn forti-toggle" :cursor "hand2"
          (button :class "net-toggle ${vpn_status.forti.up ? "on" : ""}"
                  
            "vpn")))
      ;; openfortivpn binds a tunnel device, which needs root. pkexec needs a
      ;; polkit agent and this session runs none, so the click opens a
      ;; terminal where the prompt is actually visible.
      (label :class "net-sub" :xalign 0 :wrap true
             :text "opens a terminal - openfortivpn needs root for a tunnel device, and this session runs no polkit agent")
      (vpn_config :cfg vpn_forti_config :backend "forti"))

    ;; ---- wireguard ----
    (box :orientation "v" :space-evenly false :spacing 8
         :visible {vpn_tab == "wg" && vpn_status.wg.present}
      (label :class "net-sub" :xalign 0
             :text {arraylength(vpn_status.wg.ifaces) > 0
                    ? "up: ${vpn_status.wg.ifaces}" : "no interface is up"})
      (label :class "net-sub" :xalign 0 :wrap true
             :text "wg-quick needs root, so this opens a terminal")
      (box :orientation "v" :space-evenly false :spacing 2 :class "net-list"
        (for iface in {vpn_status.wg.ifaces}
          (eventbox :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-vpn wg-toggle ${iface}" :cursor "hand2"
            (button :class "list-row on"
                    
              (box :orientation "h" :space-evenly false :spacing 10
                (label :class "list-mark" :text "●")
                (label :class "list-name" :text iface :xalign 0 :hexpand true)
                (label :class "list-meta" :text "up"))))))
      (vpn_config :cfg vpn_wg_config :backend "wg"))))
