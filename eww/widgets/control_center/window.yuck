(include "widgets/control_center/ios.yuck")
(include "widgets/control_center/sys.yuck")
(include "widgets/control_center/shortcuts.yuck")
(include "widgets/control_center/notifications.yuck")
(include "state/sys.yuck")

(defwindow control_center
    :monitor 0
    :stacking "fg"
    :windowtype "dialog"
    :namespace "eww_ios"

    :geometry (
      geometry 
        :class "bar-window"
        :x "22px"
        :y "22px"
        :width "460px"
                ;; 90%, not 94%. The layer is placed below waybar's exclusive zone,
        ;; so its top edge is at 81px - and 94% of 1080 from there runs 16px
        ;; past the bottom of the screen. 90% leaves the same margin at the
        ;; bottom as the 22px at the top.
        :height "90%"
        :orientation "vertical"
        :anchor "top right")
  (control_center_v1)
)

(defwidget control_center_v1 [?]
  ;; The whole panel scrolls, rather than each section being trimmed to make
  ;; the total fit. Sections get added over time and the screen does not grow;
  ;; capping the window and scrolling inside it is the only arrangement that
  ;; survives the next section being added.
  (scroll :vscroll true :hscroll false :vexpand true
  (box
        :class "bar-widget"
        :orientation "vertical"
        :spacing 15
        :space-evenly false

    (control_center_ios)

    (control_center_sys
        :cpu { EWW_CPU.avg }
        :ram { EWW_RAM.used_mem_perc }
        :storage { EWW_DISK["/"].used_perc }
        :net { net_down }
    )

    (control_center_shortcuts)
    (control_center_notifications)
  ))
)
