;; World clocks, on the clock.
;;
;; These were three lines at the bottom of the calendar, below the grid and the
;; day's plans - the part of the panel most likely to be pushed off-screen, for
;; the thing you open the clock to see. Their own window, on their own trigger.

(defvar clock_view "list")

(defpoll clocks
  :initial "[]"
  :interval "20s"
  :run-while is_clocks_open
  `~/.config/.dotfiles/blackwall/scripts/blackwall-cal zones`)

(defpoll clock_local
  :initial `{"time":"","date":""}`
  :interval "20s"
  :run-while is_clocks_open
  `date +'{"time":"%H:%M","date":"%A %d %B"}'`)

(defwidget clock_row [zone]
  (box :class "clock-row" :orientation "h" :space-evenly false :spacing 12
    (box :orientation "v" :space-evenly false :hexpand true
      (label :class "clock-name" :text {zone.label} :xalign 0 :limit-width 20)
      ;; A zone on a different calendar day says so. Working that out from two
      ;; clock faces is the thing a world clock exists to save you.
      (label :class "clock-meta" :xalign 0
             :text {zone.offset == "today"
                    ? "${zone.day} · ${zone.hours > 0 ? "+" : ""}${zone.hours}h"
                    : "${zone.day} · ${zone.offset}"}))
    (label :class "clock-time" :text {zone.time})
    (eventbox :cursor "hand2"
      (button :class "clock-del"
              :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-clocks remove '${zone.tz}'"
        "×"))))

(defwidget clocks_panel []
  (box :orientation "v" :space-evenly false :spacing 12 :class "bar-widget"

    (box :class "clock-local" :orientation "v" :space-evenly false :spacing 2
      (label :class "clock-local-time" :text {clock_local.time})
      (label :class "clock-local-date" :text {clock_local.date}))

    ;; No "elsewhere" heading: the panel is a clock, the big time is local,
    ;; and everything under it is self-evidently somewhere else.
    ;; The plus did toggle back, but it still looked like a plus while it was
    ;; doing it - nothing on the add view said how to leave, and every other
    ;; panel in the rice leaves by a "<" at the top left. This shows the same
    ;; back arrow, in the same place, and only becomes a plus again on the list.
    (box :orientation "h" :space-evenly false :spacing 6
      (for _ in {clock_view == "add" ? [1] : []}
        (eventbox :cursor "hand2"
          (button :class "cal-nav" :onclick "eww update clock_view=list" "‹")))
      (label :class "section-title" :xalign 0 :hexpand true
             :text {clock_view == "add" ? "add a timezone" : ""})
      (for _ in {clock_view == "add" ? [] : [1]}
        (eventbox :cursor "hand2"
          (button :class "notif-tool"
                  :tooltip "add a timezone"
                  :onclick "eww update clock_view=add"
            "󰐕"))))

    (box :orientation "v" :space-evenly false :spacing 2 :visible {clock_view == "list"}
      (for zone in clocks (clock_row :zone zone)))

    (label :class "cal-empty" :xalign 0 :text "no timezones yet"
           :visible {clock_view == "list" && arraylength(clocks) == 0})

    ;; Adding one: type a city and it is matched against the tz database, so
    ;; "bangkok" finds Asia/Bangkok without anyone memorising the area prefix.
    ;; A button, not an (input): a layer-shell panel gets no keyboard unless it
    ;; takes *every* key, so typing here went nowhere. rofi is a normal window.
    (box :orientation "v" :space-evenly false :spacing 6 :visible {clock_view == "add"}
      (eventbox :cursor "hand2"
        (button :class "cal-add"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-clocks prompt-add"
          (box :orientation "h" :space-evenly false :spacing 8
            (label :class "cal-add-icon" :text "󰐕")
            (label :class "cal-add-text" :text "name a city" :xalign 0 :hexpand true))))
      (label :class "cal-empty-hint" :xalign 0 :wrap true :show-truncated false
             :text "bangkok, lisbon, new york - matched against the tz database"))))

(defwindow clocks
  :monitor 0
  :stacking "fg"
  ;; "dialog", not "dock". A dock layer-shell surface gets a different input
  ;; region, and buttons inside it never receive the click - which is why
  ;; nothing happened when a date was pressed. Every other panel in this rice
  ;; uses dialog, and every other panel's buttons work.
  :windowtype "dialog"
  :namespace "eww_calendar"
  :geometry (geometry :anchor "top right" :width "320px" :x "22px" :y "22px")
  (box :class "bar-window" (clocks_panel)))
