(defwindow calendar
  :monitor 0
  :stacking "fg"
  :windowtype "dock"
  :namespace "eww_calendar"

  :geometry (
    geometry  
      :anchor "top right"
      :width "20%"
      :height "20%"
      :x "22px"
      :y "22px"
      :class "bar-window"
  )

  (calendar 
            ;:show-details true
            ;:show-day-names true
            ;:show-week-numbers true
            ;:show-headings true
            :class "bar-widget calendar-widget"
            :onclick ""
  )
)
