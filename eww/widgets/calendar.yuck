(defwindow calendar
  :monitor 0
  :stacking "fg"
  :windowtype "dock"

  :geometry (
    geometry  
      :anchor "top right"
      :width "20%"
      :height "20%"
      :class "bar-window"
  )

  (calendar 
            ;:show-details true
            ;:show-day-names true
            ;:show-week-numbers true
            ;:show-headings true
            :class "bar-widget"
            :onclick ""
  )
)
