;; Calendar: a month, a day, and a picker - three views in one pane.
;;
;; Clicking a day used to reveal its reminders *underneath* the grid. That
;; pushed the world clocks off the bottom and made "nothing planned" over a
;; blank strip the first thing you saw on a quiet day. A day opens instead, so
;; the pane keeps one height and the day gets all of it.
;;
;; The clocks moved out to their own window on the clock module.

(defvar cal_month "")
(defvar cal_selected "")
(defvar cal_draft "")
(defvar cal_note "")
(defvar cal_note_draft "")
(defvar cal_boards "[]")
(defvar cal_view "month")
(defvar cal_grid `{"label":"","prev":"","next":"","this":"","weeks":[]}`)
(defvar cal_picker `{"year":2026,"months":[],"years":[]}`)
(defvar cal_items "[]")

(defwidget cal_day [cell]
  (eventbox :cursor {cell.iso != "" ? "hand2" : "default"}
    (button :class "cal-day ${cell.in_month ? "" : "out"} ${cell.today ? "today" : ""} ${cal_selected == cell.iso ? "sel" : ""} ${cell.pending ? "pending" : ""} ${cell.note ? "noted" : ""}"
            :onclick {cell.iso != ""
                      ? "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui open ${cell.iso}"
                      : ""}
      (label :text {cell.day == 0 ? "" : "${cell.day}"}))))

;; ---- month -----------------------------------------------------------------

(defwidget cal_month_view []
  (box :orientation "v" :space-evenly false :spacing 12

    (box :class "cal-head" :orientation "h" :space-evenly false :spacing 6
      (eventbox :cursor "hand2"
        (button :class "cal-nav"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui goto ${cal_grid.prev}"
          "‹"))
      (eventbox :cursor "hand2" :hexpand true
        (button :class "cal-title" :hexpand true
                :tooltip "pick a month or year"
                :onclick "eww update cal_view=picker"
          (label :text {cal_grid.label} :xalign 0.5)))
      (eventbox :cursor "hand2"
        (button :class "cal-nav"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui goto ${cal_grid.next}"
          "›")))

    (box :class "cal-dow" :orientation "h" :space-evenly true
      (label :text "mo") (label :text "tu") (label :text "we")
      (label :text "th") (label :text "fr") (label :text "sa")
      (label :text "su"))

    (box :class "cal-grid" :orientation "v" :space-evenly false :spacing 3
      (for week in {cal_grid.weeks}
        (box :orientation "h" :space-evenly true :spacing 3
          (for cell in week (cal_day :cell cell)))))

    (box :class "cal-foot" :orientation "h" :space-evenly true :spacing 6
      (eventbox :cursor "hand2"
        (button :class "cal-foot-btn"
                :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui goto ${cal_grid.this}"
          "today"))
      (eventbox :cursor "hand2"
        (button :class "cal-foot-btn"
                :onclick "~/.config/eww/scripts/toggle my-sticker-window"
          "boards")))))

;; ---- picker ----------------------------------------------------------------
;; Jumping to next March was seven presses of an arrow. Two clicks now.

(defwidget cal_picker_view []
  (box :orientation "v" :space-evenly false :spacing 12

    (box :class "cal-head" :orientation "h" :space-evenly false :spacing 6
      (eventbox :cursor "hand2"
        (button :class "cal-nav" :onclick "eww update cal_view=month" "‹"))
      (label :class "cal-title-static" :text "${cal_picker.year}"
             :hexpand true :xalign 0.5))

    (label :class "section-title" :xalign 0 :text "month" :hexpand true)
    (box :orientation "v" :space-evenly false :spacing 4
      (for row in {cal_picker.month_rows}
        (box :class "cal-pick-grid" :orientation "h" :space-evenly true :spacing 4
          (for m in row
            (eventbox :cursor "hand2" :hexpand true
              (button :class "cal-pick ${m.active ? "on" : ""}"
                      :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui goto ${cal_picker.year}-${m.num} && eww update cal_view=month"
                {m.label}))))))

    (label :class "section-title" :xalign 0 :text "year" :hexpand true)
    (box :orientation "v" :space-evenly false :spacing 4
      (for row in {cal_picker.year_rows}
        (box :class "cal-pick-grid" :orientation "h" :space-evenly true :spacing 4
          (for y in row
            (eventbox :cursor "hand2" :hexpand true
              (button :class "cal-pick ${y.active ? "on" : ""} ${y.now ? "now" : ""}"
                      :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui goto ${y.y}-${cal_picker.month < 10 ? "0${cal_picker.month}" : cal_picker.month}"
                {y.y}))))))))

;; ---- one day ---------------------------------------------------------------

(defwidget cal_item [item]
  (box :class "cal-item" :orientation "h" :space-evenly false :spacing 6
    (eventbox :cursor "hand2" :hexpand true
      (button :class "cal-item-body ${item.done ? "done" : ""}"
              :hexpand true
              :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui toggle ${cal_selected} ${item.i}"
        (box :orientation "h" :space-evenly false :spacing 8
          (label :class "cal-check" :text {item.done ? "󰄲" : "󰄱"})
          (label :class "cal-item-text ${item.done ? "done" : ""}"
                 :text {item.text} :xalign 0 :hexpand true :limit-width 30))))
    ;; Send to a sticky board - the same list SUPER+M shows.
    (eventbox :cursor "hand2"
      (button :class "cal-item-send"
              :tooltip "send to a board"
              :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui push-board ${cal_selected} ${item.i} global"
        "󰐕"))
    (eventbox :cursor "hand2"
      (button :class "cal-item-del"
              :onclick "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui remove ${cal_selected} ${item.i}"
        "×"))))

(defwidget cal_day_view []
  (box :orientation "v" :space-evenly false :spacing 10

    (box :class "cal-head" :orientation "h" :space-evenly false :spacing 6
      (eventbox :cursor "hand2"
        (button :class "cal-nav" :onclick "eww update cal_view=month" "‹"))
      (label :class "cal-title-static" :text {cal_selected} :hexpand true :xalign 0))

    (label :class "section-title" :xalign 0 :text "plans" :hexpand true)

    (box :orientation "v" :space-evenly false :spacing 2
      (for item in cal_items (cal_item :item item)))

    ;; An empty day should invite, not apologise. "nothing planned" over a
    ;; blank strip was the most common thing this panel showed.
    (box :class "cal-empty-invite" :orientation "v" :space-evenly false :spacing 4
         :visible {arraylength(cal_items) == 0}
      (label :class "cal-empty-icon" :text "󰃭")
      (label :class "cal-empty-text" :text "nothing planned for this day")
      (label :class "cal-empty-hint" :text "type below to add the first thing"))

    (input :class "cal-input"
           :value cal_draft
           :onaccept "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui add ${cal_selected} {} && eww update cal_draft=''"
           :onchange "eww update cal_draft='{}'")

    (label :class "section-title" :xalign 0 :text "note" :hexpand true)
    (input :class "cal-input note"
           :value cal_note
           :onaccept "~/.config/.dotfiles/blackwall/scripts/blackwall-cal-ui note ${cal_selected} {}")))

(defwidget calendar_panel []
  (box :orientation "v" :space-evenly false :class "bar-widget cal-panel"
    (box :visible {cal_view == "month"}  (cal_month_view))
    (box :visible {cal_view == "picker"} (cal_picker_view))
    (box :visible {cal_view == "day"}    (cal_day_view))))

(defwindow calendar
  :monitor 0
  :stacking "fg"
  :windowtype "dock"
  :namespace "eww_calendar"
  :geometry (geometry :anchor "top right" :width "380px" :x "22px" :y "22px")
  (box :class "bar-window" (calendar_panel)))
