(defwidget control_center []
  (popup :title {now} :close_cmd "~/.config/eww/scripts/toggle_window.sh control_center cc_visible"
    (section :title "Quick"
      (box :class "row" :orientation "h"
        (pill :text "󰤨  Network" :cmd "~/.config/eww/scripts/toggle_window.sh network_popup network_visible" :accent true)
        (pill :text "󰕾  Volume"  :cmd "~/.config/eww/scripts/toggle_window.sh volume_popup volume_visible" :accent false)
        (pill :text "󰂚  Notifs"  :cmd "~/.config/eww/scripts/toggle_window.sh notifications_popup notifications_visible" :accent false)))

    (section :title "Toggles"
      (box :class "row" :orientation "h"
        (pill :text "󰤭  Wi-Fi toggle" :cmd "~/.config/eww/scripts/net/wifi_toggle.sh" :accent false)
        (pill :text "󰂛  DND toggle"   :cmd "~/.config/eww/scripts/notifications/dnd_toggle.sh" :accent false)
        (pill :text "󰍬  Mute toggle"  :cmd "~/.config/eww/scripts/audio/mute_toggle.sh" :accent false)))

    (section :title "Shortcuts"
      (box :class "row" :orientation "h"
        (pill :text "󰙯  Pavucontrol" :cmd "pavucontrol" :accent false)
        (pill :text "󰖟  NM Editor"   :cmd "nm-connection-editor" :accent false)
        (pill :text "󰖔  Calendar"    :cmd "~/.config/eww/scripts/toggle_window.sh calendar_popup calendar_visible" :accent false)))

    (section :title "Power"
      (box :class "row" :orientation "h"
        (pill :text "󰤄  Suspend" :cmd "systemctl suspend" :accent false)
        (pill :text "󰜉  Reboot"  :cmd "systemctl reboot" :accent false)
        (pill :text "󰐥  Poweroff":cmd "systemctl poweroff" :accent false)))))
