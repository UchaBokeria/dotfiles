(defwidget volume_popup []
  (popup
    :title "Audio"
    :close_cmd "~/.config/eww/scripts/toggle_window.sh volume_popup volume_visible"

    (section :title "Now"
      (box :orientation "v" :spacing 10

        (box :orientation "h" :spacing 10
          (label :class "big" :text {audio_state.muted ? "Muted" : (audio_state.pct + "%")})
          (label :class "small" :text {"vol=" + audio_state.vol}))

        (scale
          :min 0.0
          :max 1.5
          :round-digits 2
          :value {audio_state.vol}
          :onchange "~/.config/eww/scripts/audio/set.sh {}/1.5")

        (box :orientation "h" :spacing 10
          (pill :text "󰍬 Toggle" :cmd "~/.config/eww/scripts/audio/mute_toggle.sh" :accent false)
          (pill :text "󰕿 50%"    :cmd "~/.config/eww/scripts/audio/set.sh 0.50" :accent false)
          (pill :text "󰕾 100%"   :cmd "~/.config/eww/scripts/audio/set.sh 1.00" :accent true)
          (pill :text "󰕾 150%"   :cmd "~/.config/eww/scripts/audio/set.sh 1.50" :accent false))))

    (section :title "CAVA"
      (box :orientation "h" :spacing 4
        (for v in cava_bars
          (box :class "cava-bar" :height {6 + (v * 0.9)}))))

    (section :title "Actions"
      (box :orientation "h" :spacing 10
        (pill :text "󰙯 Pavucontrol" :cmd "pavucontrol" :accent false)
        (pill :text "󰅖 Close" :cmd "~/.config/eww/scripts/toggle_window.sh volume_popup volume_visible" :accent false)))))

