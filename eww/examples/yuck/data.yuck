(defpoll notif_list :interval "2s" :run-while notifications_visible :initial "[]"
  `~/.config/eww/scripts/notifications/list_json.sh`)

(defpoll notif_state :interval "1s" :run-while notifications_visible :initial "{\"count\":0,\"dnd\":false}"
  `~/.config/eww/scripts/notifications/state.sh`)

