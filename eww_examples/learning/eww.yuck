(defwindow test
  :monitor 0
  :stacking "fg"
  :windowtype "dock"
  :exclusive: false
  :focusable: none
  :vm-ignore true
  :geometry (geometry
              :anchor "top right"
              :width "30%"
              :height "30%")
  (test_layout  
                :timer time
                ; :text "ucha"
                :name "sk"
    "hidden"
    "visible"
  )
)

(defwidget test_layout [?text timer name]
  (box 
    (box :orientation "vertical" :class "bx"

      (box :orientation "horizontal" :class "mactions"
        (button :onclick "eww open --toggle test" "close")
        (button :onclick "eww update button_status=${!button_status}"
                :class {button_status ? "activated" : "deactivated"}
            {button_status ? "on":"off"}
        )
      )

      (button :onclick "notify-send hello ${name} && echo 'writing in file- ${name}' >> ${path}"
          text
      )

      (label :text "i  said hello mf")

      (children :nth 1) "at ${timer}"

      "mem - 1st core: ${EWW_CPU.cores[0]}"

      "we are reading from test-file: ${from_file}"

    )
  )
)

(defvar button_status true)
(defvar path "/home/scriptkid/.config/eww/test")
(defvar time-visiblity true)

(defpoll time :interval "1s"
              :initial "initial-value"
              :run-while time-visiblity
  `date +%H:%M:%S`
)

(deflisten from_file :initial "init"
  `eww state | grep path | awk '{ print $2 }' | tr -d '[:space:]' | xargs tail -F`
)

