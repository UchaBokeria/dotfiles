(defwidget network_popup []
  (popup :title "Network"
    :close_cmd "~/.config/eww/scripts/toggle_window.sh network_popup network_visible"

    (section :title "Status"
      (box :orientation "v" :spacing 8
        (box :class "row" :orientation "h"
          (box :orientation "v" :spacing 2 :hexpand true
            (label :class "big" :text {net_state.state == "" ? "—" : net_state.state})
            (label :class "small"
              :text {"iface: " + (net_state.iface == "" ? "—" : net_state.iface) + " • " + (net_state.type == "" ? "—" : net_state.type)}))
          (box :orientation "v" :spacing 2
            (label :class "kv" :text {"⭳ " + net_speed.rx})
            (label :class "kv" :text {"⭱ " + net_speed.tx})))

        (label :class "small" :text {(net_state.ip == "" ? "ip: —" : ("ip: " + net_state.ip))})
        (label :class "small" :text {(net_state.ssid == "" ? "" : ("ssid: " + net_state.ssid))})

        (box :class "row" :orientation "h"
          (pill :text "󰤭  Wi-Fi toggle" :cmd "~/.config/eww/scripts/net/wifi_toggle.sh" :accent false)
          (pill :text "󰤨  Rescan" :cmd "eww poll wifi_list" :accent false)
          (pill :text "󰅖  Close" :cmd "~/.config/eww/scripts/toggle_window.sh network_popup network_visible" :accent false))))

    (section :title "Wi-Fi"
      (scroll :vscroll true
        (box :class "list" :orientation "v" :spacing 8

          (for ap in wifi_list
            (button :class "list-item"
              :onclick {"~/.config/eww/scripts/net/wifi_connect.sh " + ap.ssid_b64}
              (box :orientation "h" :spacing 10
                (label :text {ap.in_use ? "󰤨" : "󰤯"})
                (box :orientation "v" :spacing 2 :hexpand true
                  (label :text {ap.ssid == "" ? "<hidden>" : ap.ssid})
                  (label :class "small" :text {(ap.security == "" ? "open" : ap.security)}))
                (label :class "badge" :text {ap.signal + "%"})))))))))
