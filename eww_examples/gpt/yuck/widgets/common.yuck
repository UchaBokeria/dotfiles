(defwidget popup [title close_cmd]
  (box :class "popup" :orientation "v" :spacing 12
    (centerbox :class "popup-header"
      (label :class "popup-title" :text title)
      (box)
      (button :class "icon-btn" :onclick close_cmd "󰅖"))
    (children)))

(defwidget section [title]
  (box :class "section" :orientation "v" :spacing 10
    (label :class "section-title" :text title)
    (children)))

(defwidget pill [text cmd accent]
  (button :class {accent ? "pill pill-accent" : "pill"} :onclick cmd
    (label :text text)))
