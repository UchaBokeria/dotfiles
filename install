#!/usr/bin/env bash
# Fresh Arch -> ./install -> reboot -> SDDM -> Blackwall Hyprland.
set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$HERE" || exit 1
BINARY="$HERE/installer/target/release/blackwall-install"

die() { printf 'blackwall: %s\n' "$*" >&2; exit 1; }
help() {
    cat <<'HELP'
Blackwall — install this rice on an installed Arch Linux machine.

  ./install                  review packages, machine options and changes in a TUI
  ./install --apply          install required groups without the TUI
  ./install --group NAME --apply   include an optional package group
  ./install --dry-run        preview only; never install prerequisites or ask sudo
  ./install --restore DIR    restore configuration backups from a previous run

Run as your normal sudo-enabled user, with networking working. Use a Git clone
(the SDDM theme and tmux plugins are Git submodules), not a downloaded ZIP.
Successful TTY setup asks you to reboot. Choose Blackwall (Hyprland) in SDDM;
graphical setup finishes automatically on first login. No automatic reboot.
See docs/installation.md for prerequisites, status, logs and recovery.
HELP
}

READ_ONLY=false
RESTORE=false
for arg in "$@"; do
    case "$arg" in
        -h|--help) help; exit 0 ;;
        --dry-run|--snapshot) READ_ONLY=true ;;
        --restore) RESTORE=true ;;
    esac
done
if "$READ_ONLY" && "$RESTORE"; then
    die "cannot combine --restore with --dry-run or --snapshot; no changes made."
fi

[[ $EUID -ne 0 ]] || die 'run as your normal user, not root; the installer asks sudo when needed.'
command -v git >/dev/null || die 'git is missing. From the Arch setup account install git, sudo and base-devel first.'
git -C "$HERE" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die 'this is not a Git clone. Use git clone --recurse-submodules (see docs/installation.md), not a ZIP.'

# A preview must not install Rust, build a binary, refresh sudo or leave a
# keepalive process. An existing binary can inspect the working-tree catalogue.
if "$READ_ONLY"; then
    [[ -x "$BINARY" ]] || {
        printf '%s\n' 'blackwall: preview needs a built installer; no changes made.' \
            'Build it explicitly with: cargo build --locked --release --manifest-path installer/Cargo.toml' >&2
        exit 2
    }
    for source in "$HERE"/installer/src/*.rs "$HERE"/installer/Cargo.toml "$HERE"/installer/Cargo.lock; do
        if [[ -f "$source" && "$source" -nt "$BINARY" ]]; then
            printf '%s\n' 'blackwall: installer binary is older than its source; no changes made.' \
                'Rebuild explicitly: cargo build --locked --release --manifest-path installer/Cargo.toml' >&2
            exit 2
        fi
    done
    BLACKWALL_ROOT="$HERE" "$BINARY" "$@"
    exit $?
fi

[[ -f /etc/arch-release ]] || die 'this installer targets an installed Arch Linux system.'
command -v sudo >/dev/null || die 'sudo is missing. Configure sudo access for your normal user before running ./install.'
command -v pacman >/dev/null || die 'pacman is missing.'
sudo -v || die 'sudo access is required for packages and system services.'

# Keep sudo alive while THIS process owns the installation. Do not exec the
# binary: exec bypasses the EXIT trap and used to leave this loop behind.
KEEPALIVE=''
cleanup() {
    if [[ -n "$KEEPALIVE" ]]; then
        kill "$KEEPALIVE" 2>/dev/null || true
        wait "$KEEPALIVE" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
(
    sleeper=''
    trap 'exit 0' TERM INT
    trap 'if [[ -n "$sleeper" ]]; then kill "$sleeper" 2>/dev/null || true; wait "$sleeper" 2>/dev/null || true; fi' EXIT
    while true; do
        sleep 50 & sleeper=$!
        wait "$sleeper" || exit
        sleeper=''
        sudo -n true >/dev/null 2>&1 || exit
    done
) &
KEEPALIVE=$!

# Both the Rust linker and makepkg need a compiler/toolchain before the
# catalogue itself can run. Always do a full upgrade, never pacman -Sy + -S.
bootstrap=()
pacman -Qq base-devel >/dev/null 2>&1 || bootstrap+=(base-devel)
command -v lspci >/dev/null || bootstrap+=(pciutils)
command -v cargo >/dev/null || bootstrap+=(rust)
if (( ${#bootstrap[@]} )); then
    printf '%s\n' 'Installing build prerequisites and updating Arch…'
    sudo pacman -Syu --needed --noconfirm "${bootstrap[@]}" || die 'could not install build prerequisites.'
fi
command -v cargo >/dev/null || die 'cargo is still missing after prerequisite setup.'
printf '%s\n' 'Building the installer…'
cargo build --locked --release --manifest-path "$HERE/installer/Cargo.toml" || die 'the installer did not build.'
BLACKWALL_ROOT="$HERE" "$BINARY" "$@"
exit $?
