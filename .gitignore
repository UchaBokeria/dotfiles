# fish rewrites this on every `set -U`, so it collects machine state and
# secrets (an exported MODEL_API_KEY was sitting in the tracked copy, along
# with seventeen committed fish_variablesXXXXXXXX atomic-save leftovers). The
# five variables that are rice configuration are set by the installer step
# `fish-universals`.
fish/fish_variables*
tmux/plugins/*
**/colors.css
**/colors.scss
firebase-debug.log
tmux/.logo/
tmux/README.md
tmux/install.sh
colors.*
*_colors.conf
*.orig
a.out
__pycache__/
*.pyc
nexttask
*-debug.log
tpm_log.txt
custom.conf
.snapshots/

# Generated by theme/blackwall-theme, but committed anyway: hyprland.conf
# `source`s colors.conf and kitty.conf `include`s colors.conf, so a fresh clone
# that lacks them starts with a broken config rather than an unstyled one. They
# are regenerated on every wallpaper change; the committed copy is just a
# working default. The blanket `colors.*` rule above would otherwise catch both.
!hypr/configs/colors.conf
!kitty/colors.conf

# nwg-look's export, hand-maintained, and a [[link]] the installer copies into
# ~/.config/gtk-3.0. The blanket **/colors.css above was hiding it, so a fresh
# clone had a catalogue entry pointing at a file that was never committed.
!home/.config/gtk-3.0/colors.css

# the installer build output; built on the target machine by ./install
installer/target/

# Written per machine by the installer (modifier key, monitors, GPU, extra
# binds). hypr/lua/machine.lua.example is the tracked template.
hypr/lua/machine.lua

# scratch screenshot from wa UI work
whatsapp/e.png

# Carries plaintext sshpass passwords and internal host IPs. It lives in
# ~/.local/bin on the machine that needs it and must never be in the repo
# again - see docs/cheatsheet.md.
scripts/c2a

# opencode generates the browser extension signing key on first use. It is a
# private key: it belongs on the machine, never in the repo.
opencode/ext-key.pem
opencode/*.pem
